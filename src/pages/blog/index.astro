---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const categoryLabel: Record<string, string> = {
  "post-quantum": "Architecture",
  compliance: "Compliance",
  comparison: "Comparison",
  fundamentals: "Fundamentals",
  technical: "Technical",
  industry: "Industry",
};

// NOTE: the "post-quantum" key is kept for backwards-compat with existing
// blog posts under category: "post-quantum". Its display label was relabelled
// to "Architecture" on 2026-06-01 when PQC was disabled in the product.
const categories = ["post-quantum", "comparison", "compliance", "technical", "fundamentals", "industry"] as const;

// Category post counts
const counts = Object.fromEntries(
  categories.map((c) => [c, allPosts.filter((p) => p.data.category === c).length])
);

// Featured post (first with featured:true, else latest)
const featured = allPosts.find((p) => p.data.featured) ?? allPosts[0];

// Remaining posts (not featured)
const rest = allPosts.filter((p) => p.id !== featured?.id);

// Blog index structured data — Blog + ItemList of recent posts + Breadcrumb.
// Helps Google recognize this as a hub page and surfaces the post list in
// search results. Also signals authority for AEO retrieval on category queries.
const blogIndexSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://quickztna.com/blog/",
  url: "https://quickztna.com/blog/",
  name: "QuickZTNA Blog",
  description: "Engineering notes, compliance deep-dives, and honest comparisons on Zero Trust Network Access, workforce security, and EU/US regulatory frameworks.",
  publisher: { "@id": "https://quickztna.com/#organization" },
  inLanguage: "en",
  blogPost: allPosts.slice(0, 20).map((p) => {
    const slug = p.id.replace(/\.md$/, "");
    return {
      "@type": "BlogPosting",
      headline: p.data.title,
      description: p.data.description,
      url: `https://quickztna.com/blog/${slug}/`,
      datePublished: p.data.publishedAt.toISOString(),
      dateModified: (p.data.updatedAt ?? p.data.publishedAt).toISOString(),
      author: { "@type": "Person", name: p.data.author.name },
    };
  }),
};

const blogBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://quickztna.com" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://quickztna.com/blog/" },
  ],
};
---
<SiteLayout
  title="Blog — QuickZTNA | ZTNA + Workforce Security Deep Dives"
  description="Engineering notes, compliance deep-dives, and honest comparisons on ZTNA, workforce security, NIS2/DORA. Every claim sourced. Every feature shipping today."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogIndexSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(blogBreadcrumbSchema)} is:inline />
  </Fragment>
  <!-- Hero banner -->
  <section class="border-b border-border bg-hero">
    <div class="relative overflow-hidden">
      <div class="absolute inset-0 bg-grid opacity-40" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-primary">Blog</p>
        <h1 class="mt-3 max-w-3xl text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl">
          Zero-trust + workforce security, explained carefully.
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-muted-foreground">
          Engineering notes, compliance deep-dives, and honest comparisons.
          Every claim is sourced. Every product feature is shipping today.
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-[1fr_17rem] lg:gap-12 xl:gap-16">

      <!-- ── MAIN COLUMN ──────────────────────────────────────────── -->
      <div>

        <!-- Category filter tabs -->
        <div
          class="mb-8 flex flex-wrap gap-2"
          role="tablist"
          aria-label="Filter by category"
          id="cat-filters"
        >
          <button
            data-cat="all"
            class="cat-btn active rounded-full border border-primary bg-primary px-3.5 py-1.5 font-mono text-xs font-semibold text-primary-foreground transition-colors"
          >
            All <span class="opacity-70">({allPosts.length})</span>
          </button>
          {categories.map((c) => counts[c] > 0 && (
            <button
              data-cat={c}
              class="cat-btn rounded-full border border-border px-3.5 py-1.5 font-mono text-xs font-medium text-muted-foreground hover:border-primary/40 hover:text-foreground transition-colors"
            >
              {categoryLabel[c]} <span class="opacity-60">({counts[c]})</span>
            </button>
          ))}
        </div>

        <!-- Featured post card -->
        {featured && (
          <a
            href={`/blog/${featured.id.replace(/\.md$/, "")}/`}
            data-post-cat={featured.data.category}
            class="featured-card group mb-10 flex flex-col gap-4 rounded-2xl border border-border bg-card p-6 shadow-sm hover:border-primary/40 hover:shadow-md transition-all sm:flex-row sm:items-start"
          >
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="rounded-full border border-primary/30 bg-primary/10 px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-primary">
                  {categoryLabel[featured.data.category]}
                </span>
                <span class="rounded-full border border-warning/40 bg-warning/10 px-3 py-0.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-warning-foreground">
                  Featured
                </span>
                {featured.data.wordCount && (
                  <span class="font-mono text-xs text-muted-foreground">
                    {Math.ceil(featured.data.wordCount / 230)} min read
                  </span>
                )}
              </div>
              <h2 class="text-2xl font-extrabold leading-tight tracking-tight text-foreground group-hover:text-primary transition-colors sm:text-3xl">
                {featured.data.title}
              </h2>
              <p class="mt-3 text-base text-muted-foreground leading-relaxed line-clamp-3">
                {featured.data.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {featured.data.tags.slice(0, 5).map((t) => (
                  <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[10px] text-muted-foreground">
                    #{t}
                  </span>
                ))}
              </div>
              <div class="mt-4 font-mono text-xs text-muted-foreground">
                <time datetime={featured.data.publishedAt.toISOString()}>
                  {featured.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                </time>
                {" · "}{featured.data.author.name}
              </div>
            </div>
          </a>
        )}

        <!-- Post grid -->
        <ul
          id="post-grid"
          class="grid gap-6 sm:grid-cols-2"
          aria-live="polite"
          aria-atomic="true"
        >
          {rest.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const readTime = post.data.wordCount ? Math.ceil(post.data.wordCount / 230) : null;
            return (
              <li data-post-cat={post.data.category}>
                <a
                  href={`/blog/${slug}/`}
                  class="group flex h-full flex-col rounded-xl border border-border bg-card p-5 hover:border-primary/40 hover:shadow-sm transition-all"
                >
                  <div class="mb-3 flex items-center justify-between gap-2">
                    <span class="rounded-full border border-border px-2.5 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                      {categoryLabel[post.data.category]}
                    </span>
                    {readTime && (
                      <span class="font-mono text-[10px] text-muted-foreground">{readTime} min</span>
                    )}
                  </div>
                  <h2 class="flex-1 text-base font-bold leading-snug text-foreground group-hover:text-primary transition-colors line-clamp-3">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-muted-foreground line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-1">
                    {post.data.tags.slice(0, 3).map((t) => (
                      <span class="rounded font-mono text-[10px] text-muted-foreground">#{t}</span>
                    ))}
                  </div>
                  <time
                    datetime={post.data.publishedAt.toISOString()}
                    class="mt-3 block font-mono text-[10px] text-muted-foreground/70"
                  >
                    {post.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </time>
                </a>
              </li>
            );
          })}
        </ul>

        <!-- Empty state -->
        <p id="no-posts" class="hidden mt-12 text-center text-muted-foreground">
          No posts in this category yet.
        </p>
      </div>

      <!-- ── SIDEBAR ──────────────────────────────────────────────── -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">

          <!-- CTA -->
          <div class="rounded-xl border border-primary/20 bg-gradient-to-b from-accent/50 to-background p-5">
            <p class="font-mono text-[10px] font-bold uppercase tracking-widest text-primary">Free forever</p>
            <p class="mt-2 text-sm font-semibold text-foreground">ZTNA mesh for 100 devices</p>
            <p class="mt-1 text-xs text-muted-foreground">WireGuard mesh + DLP + AI Operator. One install command. No card.</p>
            <a
              href="https://login.quickztna.com/auth"
              class="mt-4 block w-full rounded-md bg-primary py-2 text-center text-xs font-semibold text-primary-foreground hover:opacity-90 transition-opacity"
            >
              Start free →
            </a>
          </div>

          <!-- Category counts -->
          <div class="rounded-xl border border-border bg-card p-5">
            <p class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
              Browse by topic
            </p>
            <ul class="space-y-2">
              <li>
                <button
                  data-cat="all"
                  class="cat-btn flex w-full items-center justify-between rounded-md px-2 py-1.5 text-sm hover:bg-muted transition-colors text-left"
                >
                  <span class="font-medium">All posts</span>
                  <span class="font-mono text-xs text-muted-foreground">{allPosts.length}</span>
                </button>
              </li>
              {categories.map((c) => counts[c] > 0 && (
                <li>
                  <button
                    data-cat={c}
                    class="cat-btn flex w-full items-center justify-between rounded-md px-2 py-1.5 text-sm hover:bg-muted transition-colors text-left"
                  >
                    <span>{categoryLabel[c]}</span>
                    <span class="font-mono text-xs text-muted-foreground">{counts[c]}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <!-- Latest 5 posts -->
          <div class="rounded-xl border border-border bg-card p-5">
            <p class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
              Latest posts
            </p>
            <ul class="space-y-3">
              {allPosts.slice(0, 5).map((post) => {
                const s = post.id.replace(/\.md$/, "");
                return (
                  <li>
                    <a href={`/blog/${s}/`} class="group block">
                      <p class="text-sm font-medium leading-snug text-foreground group-hover:text-primary line-clamp-2 transition-colors">
                        {post.data.title}
                      </p>
                      <time class="font-mono text-[10px] text-muted-foreground" datetime={post.data.publishedAt.toISOString()}>
                        {post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                      </time>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>

        </div>
      </aside>
    </div>
  </div>
</SiteLayout>

<script>
  // Client-side category filtering — no framework, no page reload
  const allCards = document.querySelectorAll<HTMLElement>("[data-post-cat]");
  const noPostsEl = document.getElementById("no-posts");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-cat]");

  const setActive = (activeCat: string) => {
    // Update button styles
    buttons.forEach((btn) => {
      const isActive = btn.dataset.cat === activeCat;
      btn.classList.toggle("bg-primary", isActive);
      btn.classList.toggle("text-primary-foreground", isActive);
      btn.classList.toggle("border-primary", isActive);
      btn.classList.toggle("text-muted-foreground", !isActive);
      btn.classList.toggle("border-border", !isActive);
    });

    // Show/hide cards
    let visible = 0;
    allCards.forEach((card) => {
      const show = activeCat === "all" || card.dataset.postCat === activeCat;
      card.style.display = show ? "" : "none";
      if (show) visible++;
    });

    if (noPostsEl) noPostsEl.classList.toggle("hidden", visible > 0);
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => setActive(btn.dataset.cat ?? "all"));
  });

  // Initialise from URL param if present
  const params = new URLSearchParams(window.location.search);
  const initCat = params.get("category") ?? "all";
  setActive(initCat);
</script>
