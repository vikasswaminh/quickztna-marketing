---
import { getCollection } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

// Sort descending by publishedAt
allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const featured = allPosts[0];
const rest = allPosts.slice(1);

const categoryLabel: Record<string, string> = {
  architecture: "Architecture",
  comparison: "Comparison",
  compliance: "Compliance",
  technical: "Technical",
  fundamentals: "Fundamentals",
  industry: "Industry",
  "post-quantum": "Architecture",
};

// Unique normalized categories
const categoryKeys = [
  "architecture",
  "comparison",
  "compliance",
  "technical",
  "fundamentals",
  "industry",
];

// Count per normalized category
const counts: Record<string, number> = {
  architecture: 0,
  comparison: 0,
  compliance: 0,
  technical: 0,
  fundamentals: 0,
  industry: 0,
};

for (const post of allPosts) {
  const normCat = post.data.category === "post-quantum" ? "architecture" : post.data.category;
  counts[normCat] = (counts[normCat] ?? 0) + 1;
}

const featuredSlug = featured ? featured.id.replace(/\.md$/, "") : "";
const featuredReadTime = featured?.data.wordCount
  ? Math.ceil(featured.data.wordCount / 230)
  : 16;
const featuredNormCat = featured?.data.category === "post-quantum" ? "architecture" : (featured?.data.category ?? "architecture");



const categoryBadgeColors: Record<string, string> = {
  architecture: "bg-amber-500 text-white",
  comparison: "bg-blue-600 text-white",
  compliance: "bg-emerald-600 text-white",
  technical: "bg-purple-600 text-white",
  fundamentals: "bg-cyan-700 text-white",
  industry: "bg-rose-600 text-white",
  "post-quantum": "bg-amber-500 text-white",
};
---

<SiteLayout
  title="Blog — QuickZTNA · Zero Trust + Workforce Security"
  description="Engineering notes, compliance deep-dives, and honest comparisons. Every claim is sourced. Every product feature is shipping today."
>
  <!-- ── Full-Width Hero Band ──────────────────────────────────────── -->
  <div class="w-full bg-[#eef2f9] border-b border-blue-100/60">
    <div class="mx-auto max-w-[1560px] px-4 py-10 sm:px-6 lg:px-12 xl:py-14">
      <p class="text-[11px] font-extrabold uppercase tracking-[0.18em] text-blue-600 mb-3">
        BLOG
      </p>
      <h1 class="text-4xl sm:text-5xl xl:text-6xl font-black tracking-tight text-gray-950 leading-[1.05] max-w-3xl">
        Zero-trust + workforce security, explained carefully.
      </h1>
      <p class="mt-4 text-sm sm:text-base text-gray-500 font-normal leading-relaxed max-w-2xl">
        Engineering notes, compliance deep-dives, and honest comparisons. Every claim is sourced. Every product feature is shipping today.
      </p>
    </div>
  </div>

  <!-- ── Full-Width Vibrant Blue Ribbon Bar (Sticky Navigation) ─────── -->
  <div class="sticky top-[57px] z-30 w-full bg-[#0070ba] shadow-md transition-all">
    <div class="mx-auto max-w-[1560px] px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-center gap-2 overflow-x-auto py-2.5 sm:py-3 scrollbar-none">
        
        <!-- All -->
        <button
          data-cat="all"
          class="cat-pill ribbon-btn flex items-center gap-1.5 rounded-full bg-white px-4 py-1.5 text-xs font-bold text-[#0070ba] shadow-sm transition-all cursor-pointer shrink-0"
        >
          <span>All</span>
          <span class="rounded-full bg-[#0070ba] text-white px-1.5 py-0.2 text-[10px] font-extrabold">{allPosts.length}</span>
        </button>

        <span class="text-white/40 select-none shrink-0 font-bold">·</span>

        <!-- WireGuard & ABAC -->
        <button
          data-cat="architecture"
          class="cat-pill ribbon-btn flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 hover:bg-white/20 hover:border-white/50 px-4 py-1.5 text-xs font-semibold text-white transition-all cursor-pointer shrink-0"
        >
          <span>WireGuard & ABAC</span>
          <span class="rounded-full bg-white/20 text-white px-1.5 py-0.2 text-[10px] font-bold">{counts["architecture"]}</span>
        </button>

        <span class="text-white/40 select-none shrink-0 font-bold">·</span>

        <!-- Workforce DLP -->
        <button
          data-cat="compliance"
          class="cat-pill ribbon-btn flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 hover:bg-white/20 hover:border-white/50 px-4 py-1.5 text-xs font-semibold text-white transition-all cursor-pointer shrink-0"
        >
          <span>Workforce DLP</span>
          <span class="rounded-full bg-white/20 text-white px-1.5 py-0.2 text-[10px] font-bold">{counts["compliance"]}</span>
        </button>

        <span class="text-white/40 select-none shrink-0 font-bold">·</span>

        <!-- Device Posture -->
        <button
          data-cat="technical"
          class="cat-pill ribbon-btn flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 hover:bg-white/20 hover:border-white/50 px-4 py-1.5 text-xs font-semibold text-white transition-all cursor-pointer shrink-0"
        >
          <span>Device Posture</span>
          <span class="rounded-full bg-white/20 text-white px-1.5 py-0.2 text-[10px] font-bold">{counts["technical"]}</span>
        </button>

        <span class="text-white/40 select-none shrink-0 font-bold">·</span>

        <!-- Software Inventory -->
        <button
          data-cat="fundamentals"
          class="cat-pill ribbon-btn flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 hover:bg-white/20 hover:border-white/50 px-4 py-1.5 text-xs font-semibold text-white transition-all cursor-pointer shrink-0"
        >
          <span>Software Inventory</span>
          <span class="rounded-full bg-white/20 text-white px-1.5 py-0.2 text-[10px] font-bold">{counts["fundamentals"]}</span>
        </button>

        <span class="text-white/40 select-none shrink-0 font-bold">·</span>

        <!-- User-Risk Scoring -->
        <button
          data-cat="comparison"
          class="cat-pill ribbon-btn flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 hover:bg-white/20 hover:border-white/50 px-4 py-1.5 text-xs font-semibold text-white transition-all cursor-pointer shrink-0"
        >
          <span>User-Risk Scoring</span>
          <span class="rounded-full bg-white/20 text-white px-1.5 py-0.2 text-[10px] font-bold">{counts["comparison"]}</span>
        </button>

        <span class="text-white/40 select-none shrink-0 font-bold">·</span>

        <!-- AI Operator & Policy -->
        <button
          data-cat="industry"
          class="cat-pill ribbon-btn flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 hover:bg-white/20 hover:border-white/50 px-4 py-1.5 text-xs font-semibold text-white transition-all cursor-pointer shrink-0"
        >
          <span>AI Operator & Policy</span>
          <span class="rounded-full bg-white/20 text-white px-1.5 py-0.2 text-[10px] font-bold">{counts["industry"]}</span>
        </button>

      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1560px] px-4 py-8 sm:px-6 lg:px-8">
    
    <!-- 3-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-[250px_1fr_250px] xl:grid-cols-[270px_1fr_270px] gap-6 xl:gap-8 items-start">
      
      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- ── LEFT SIDEBAR (CTA + Browse by Topic + Founder) ──────── -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <aside class="hidden lg:block space-y-6 sticky top-36">
        
        <!-- Widget 1: Free Forever CTA Card -->
        <div class="rounded-2xl border border-blue-100/80 bg-white p-5 shadow-soft hover:shadow-elevated transition-shadow">
          <span class="font-mono text-[11px] font-extrabold uppercase tracking-widest text-blue-600 block mb-1">
            FREE FOREVER
          </span>
          <h3 class="text-base font-extrabold text-gray-900 leading-snug">
            ZTNA mesh for your whole team
          </h3>
          <p class="mt-2 text-xs text-gray-500 leading-relaxed">
            WireGuard mesh + DLP + AI Operator. One install command. No card.
          </p>
          <a
            href="https://login.quickztna.com/auth"
            class="mt-4 flex items-center justify-center gap-1.5 w-full rounded-full bg-blue-600 py-2.5 px-4 text-center text-xs font-bold text-white hover:bg-blue-700 shadow-md shadow-blue-600/20 transition-all active:scale-95"
          >
            <span>Start free</span>
            <span class="text-sm">→</span>
          </a>
        </div>

        <!-- Widget 2: Browse By Topic Card -->
        <div class="rounded-2xl border border-gray-200/80 bg-white p-5 shadow-soft">
          <h3 class="mb-3 font-mono text-[11px] font-extrabold uppercase tracking-wider text-blue-600">
            BROWSE BY TOPIC
          </h3>
          <nav class="space-y-1" aria-label="Topic Categories">
            <button
              data-cat="all"
              class="cat-btn flex w-full items-center justify-between rounded-lg bg-blue-600 px-3.5 py-2.5 text-xs font-bold text-white shadow-sm transition-all text-left cursor-pointer"
            >
              <span>All posts</span>
              <span class="font-mono text-[11px] text-blue-100 font-semibold">{allPosts.length}</span>
            </button>
            {categoryKeys.map((c) => counts[c] > 0 && (
              <button
                data-cat={c}
                class="cat-btn flex w-full items-center justify-between rounded-lg px-3.5 py-2.5 text-xs font-semibold text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors text-left cursor-pointer"
              >
                <span>{categoryLabel[c]}</span>
                <span class="font-mono text-[11px] text-gray-400 font-medium">{counts[c]}</span>
              </button>
            ))}
          </nav>
        </div>



      </aside>

      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- ── CENTER MAIN CONTENT (Header + Featured + Cards) ─────── -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <main class="min-w-0 space-y-6">
        

        <!-- Section Badge & Subheading -->
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-orange-500 px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider text-white shadow-sm shadow-orange-500/20">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 23c6.075 0 11-4.925 11-11 0-4.04-2.18-7.57-5.44-9.5-.33-.2-.76-.08-.94.25-.19.33-.08.76.25.94C19.64 5.25 21.5 8.39 21.5 12c0 5.24-4.26 9.5-9.5 9.5S2.5 17.24 2.5 12c0-3.61 1.86-6.75 4.63-8.31.33-.18.44-.61.25-.94-.18-.33-.61-.45-.94-.25C3.18 4.43 1 7.96 1 12c0 6.075 4.925 11 11 11z"/>
              <path d="M12 2C8.5 6 6 8.5 6 12c0 3.31 2.69 6 6 6s6-2.69 6-6c0-3.5-2.5-6-6-10zm0 14c-2.21 0-4-1.79-4-4 0-1.89 1.34-3.62 3.12-5.45.47-.48 1.29-.48 1.76 0C14.66 8.38 16 10.11 16 12c0 2.21-1.79 4-4 4z"/>
            </svg>
            <span>NEWEST ARTICLES</span>
          </span>
          <span class="text-xs font-medium text-gray-500">Latest from our experts</span>
        </div>

        <!-- Featured Post Hero Card (Golden / Orange Accent Border with Left Image) -->
        {featured && (
          <div id="featured-post" data-post-cat={featuredNormCat} class="group">
            <a
              href={`/blog/${featuredSlug}/`}
              class="relative block overflow-hidden rounded-2xl border-2 border-blue-200 bg-white p-4 sm:p-6 shadow-soft hover:shadow-elevated hover:border-blue-400 transition-all"
            >
              <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
                

                <!-- Content -->
                <div class="col-span-12 flex flex-col justify-between h-full py-1">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2.5">
                      <span class={`inline-block rounded-full px-3 py-0.5 text-[10px] font-extrabold uppercase tracking-wider ${categoryBadgeColors[featuredNormCat] ?? "bg-blue-600 text-white"}`}>
                        {categoryLabel[featuredNormCat] ?? "Architecture"}
                      </span>
                      <span class="inline-flex items-center gap-1 rounded-md bg-orange-500 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white">
                        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2C8.5 6 6 8.5 6 12c0 3.31 2.69 6 6 6s6-2.69 6-6c0-3.5-2.5-6-6-10z"/>
                        </svg>
                        <span>NEW</span>
                      </span>
                    </div>

                    <h2 class="text-base sm:text-lg xl:text-xl font-extrabold text-gray-900 leading-snug group-hover:text-blue-600 transition-colors">
                      {featured.data.title}
                    </h2>

                    <p class="mt-2.5 text-xs sm:text-sm text-gray-500 leading-relaxed line-clamp-3">
                      {featured.data.description}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-gray-100 flex items-center gap-2 text-xs font-semibold text-gray-500">
                    <span>{featuredReadTime} min read</span>
                    <span class="text-gray-300">•</span>
                    <span class="text-amber-600 font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                      <span>Read article</span>
                      <span>→</span>
                    </span>
                  </div>
                </div>

              </div>
            </a>
          </div>
        )}

        <!-- Grid of Blog Posts (3 Columns on desktop / 2 on tablet) -->
        <ul
          id="post-grid"
          class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5"
          aria-live="polite"
        >
          {rest.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const readTime = post.data.wordCount ? Math.ceil(post.data.wordCount / 230) : 6;
            const normCat = post.data.category === "post-quantum" ? "architecture" : post.data.category;
            const badgeColor = categoryBadgeColors[normCat] || "bg-amber-500 text-white";
            
            return (
              <li data-post-cat={normCat} class="flex">
                <a
                  href={`/blog/${slug}/`}
                  class="group flex h-full w-full flex-col justify-between rounded-2xl border border-blue-100 bg-white p-4 sm:p-5 shadow-soft hover:shadow-elevated hover:border-blue-300 transition-all"
                >
                  <div>
                    <div class="mb-3">
                      <span class={`inline-block rounded-md px-2.5 py-0.5 text-[10px] font-extrabold uppercase tracking-wider ${badgeColor}`}>
                        {categoryLabel[normCat] ?? normCat}
                      </span>
                    </div>

                    <h2 class="text-sm sm:text-base font-extrabold leading-snug text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-2">
                      {post.data.title}
                    </h2>

                    <p class="mt-2 text-xs text-gray-500 font-normal leading-relaxed line-clamp-3">
                      {post.data.description}
                    </p>
                  </div>

                  <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-[11px] font-semibold text-gray-400">
                    <span>
                      {readTime} min read
                    </span>
                    <span class="text-amber-600 font-bold group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
                      <span>Read article</span>
                      <span>→</span>
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>

        <!-- Empty state when category filtering has no matches -->
        <p id="no-posts" class="hidden mt-12 text-center text-sm font-semibold text-gray-500">
          No posts found in this category.
        </p>

      </main>

      <!-- ══════════════════════════════════════════════════════════ -->
      <!-- ── RIGHT SIDEBAR (AI Special + Latest Posts + CTA) ─────── -->
      <!-- ══════════════════════════════════════════════════════════ -->
      <aside class="hidden lg:block space-y-6 sticky top-36">
        


        <!-- Widget: Latest Posts List -->
        <div class="rounded-2xl border border-gray-200/80 bg-white p-5 shadow-soft">
          <h3 class="mb-3 font-mono text-[11px] font-extrabold uppercase tracking-wider text-blue-600">
            LATEST POSTS
          </h3>
          <ul class="divide-y divide-gray-100">
            {allPosts.slice(0, 7).map((post, idx) => {
              const s = post.id.replace(/\.md$/, "");
              return (
                <li class={idx > 0 ? "pt-3.5" : ""}>
                  <a href={`/blog/${s}/`} class="group block pb-3.5">
                    <p class="text-xs font-bold leading-snug text-gray-900 group-hover:text-blue-600 line-clamp-2 transition-colors">
                      {post.data.title}
                    </p>
                    <time class="mt-1 block font-mono text-[10px] text-gray-400 font-medium" datetime={post.data.publishedAt.toISOString()}>
                      {post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                    </time>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>




      </aside>

    </div>
  </div>
</SiteLayout>

<script>
  // Client-side category filtering
  const allCards = document.querySelectorAll<HTMLElement>("[data-post-cat]");
  const featuredEl = document.getElementById("featured-post");
  const noPostsEl = document.getElementById("no-posts");
  const pills = document.querySelectorAll<HTMLButtonElement>(".cat-pill");
  const sideButtons = document.querySelectorAll<HTMLButtonElement>(".cat-btn");

  const setActive = (activeCat: string) => {
    // Update ribbon pill styles
    pills.forEach((btn) => {
      const isActive = btn.dataset.cat === activeCat;
      const countBadge = btn.querySelector("span:last-child");
      if (isActive) {
        btn.className = "cat-pill ribbon-btn flex items-center gap-1.5 rounded-full bg-white px-4 py-1.5 text-xs font-bold text-[#0070ba] shadow-sm transition-all cursor-pointer shrink-0";
        if (countBadge) countBadge.className = "rounded-full bg-[#0070ba] text-white px-1.5 py-0.2 text-[10px] font-extrabold";
      } else {
        btn.className = "cat-pill ribbon-btn flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 hover:bg-white/20 hover:border-white/50 px-4 py-1.5 text-xs font-semibold text-white transition-all cursor-pointer shrink-0";
        if (countBadge) countBadge.className = "rounded-full bg-white/20 text-white px-1.5 py-0.2 text-[10px] font-bold";
      }
    });

    // Update left sidebar button styles
    sideButtons.forEach((btn) => {
      const isActive = btn.dataset.cat === activeCat;
      if (isActive) {
        btn.className = "cat-btn flex w-full items-center justify-between rounded-lg bg-blue-600 px-3.5 py-2.5 text-xs font-bold text-white shadow-sm transition-all text-left cursor-pointer";
        const countSpan = btn.querySelector("span:last-child");
        if (countSpan) countSpan.className = "font-mono text-[11px] text-blue-100 font-semibold";
      } else {
        btn.className = "cat-btn flex w-full items-center justify-between rounded-lg px-3.5 py-2.5 text-xs font-semibold text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors text-left cursor-pointer";
        const countSpan = btn.querySelector("span:last-child");
        if (countSpan) countSpan.className = "font-mono text-[11px] text-gray-400 font-medium";
      }
    });

    // Show/hide cards
    let visible = 0;
    allCards.forEach((card) => {
      const cardCat = card.dataset.postCat;
      const isCardActive = activeCat === "all" || cardCat === activeCat;
      card.style.display = isCardActive ? "" : "none";
      if (isCardActive) visible++;
    });

    if (noPostsEl) noPostsEl.classList.toggle("hidden", visible > 0);
  };

  pills.forEach((btn) => {
    btn.addEventListener("click", () => setActive(btn.dataset.cat ?? "all"));
  });

  sideButtons.forEach((btn) => {
    btn.addEventListener("click", () => setActive(btn.dataset.cat ?? "all"));
  });

  // Initialise from URL param if present
  const params = new URLSearchParams(window.location.search);
  const initCat = params.get("category") ?? "all";
  if (initCat !== "all") {
    setActive(initCat);
  }
</script>

