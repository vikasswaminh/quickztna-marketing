---
import { getCollection } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

// Sort descending by publishedAt
allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const featured = allPosts[0];
const rest = allPosts.slice(1);

const categoryLabel: Record<string, string> = {
  architecture: "Architecture",
  comparison: "Comparison",
  compliance: "Compliance",
  technical: "Technical",
  fundamentals: "Fundamentals",
  industry: "Industry",
};

const categories = Object.keys(categoryLabel);

// Count per category
const counts: Record<string, number> = {};
for (const post of allPosts) {
  counts[post.data.category] = (counts[post.data.category] ?? 0) + 1;
}

const featuredSlug = featured ? featured.id.replace(/\.md$/, "") : "";
const featuredReadTime = featured?.data.wordCount
  ? Math.ceil(featured.data.wordCount / 230)
  : null;
---

<SiteLayout
  title="Blog — QuickZTNA · Zero Trust Architecture, Compliance & Engineering"
  description="Engineering deep-dives, protocol comparisons, and compliance playbooks for modern security teams."
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent-light px-3 py-0.5 text-[11px] font-bold uppercase tracking-wider text-accent mb-3">
        ENGINEERING & RESEARCH
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-primary sm:text-4xl">
        Blog
      </h1>
      <p class="mt-2 text-sm text-muted-foreground max-w-2xl font-medium">
        Deep-dives into WireGuard mesh architecture, identity-first networking, continuous compliance, and zero-trust engineering.
      </p>
    </div>

    <!-- Category filter pills on top -->
    <div class="mb-8 flex flex-wrap items-center gap-2 border-b border-border pb-4">
      <button
        data-cat="all"
        class="cat-pill rounded-full border border-accent bg-accent px-4 py-1.5 font-mono text-xs font-bold text-white transition-all shadow-sm active:scale-95 cursor-pointer"
      >
        All posts ({allPosts.length})
      </button>
      {categories.map((c) => counts[c] > 0 && (
        <button
          data-cat={c}
          class="cat-pill rounded-full border border-border bg-white px-4 py-1.5 font-mono text-xs font-semibold text-muted-foreground hover:border-accent hover:text-accent transition-all active:scale-95 cursor-pointer"
        >
          {categoryLabel[c]} ({counts[c]})
        </button>
      ))}
    </div>

    <!-- Main grid: Left content + Right sidebar -->
    <div class="grid gap-10 lg:grid-cols-[1fr_320px]">
      
      <!-- ── LEFT CONTENT ────────────────────────────────────────── -->
      <div class="min-w-0">
        
        <!-- Featured Post Hero Card -->
        {featured && (
          <div class="mb-10" id="featured-post" data-post-cat={featured.data.category}>
            <a
              href={`/blog/${featuredSlug}/`}
              class="group relative block overflow-hidden rounded-2xl border border-border bg-white p-6 sm:p-8 shadow-soft hover:border-accent hover:shadow-elevated transition-all"
            >
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-accent-light px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-accent border border-accent/20">
                  Featured · {categoryLabel[featured.data.category] ?? featured.data.category}
                </span>
                {featuredReadTime && (
                  <span class="font-mono text-xs text-muted-foreground font-medium">
                    · {featuredReadTime} min read
                  </span>
                )}
              </div>
              <h2 class="mt-4 text-xl sm:text-2xl font-bold tracking-tight text-primary group-hover:text-accent transition-colors">
                {featured.data.title}
              </h2>
              <p class="mt-2.5 text-xs sm:text-sm text-muted-foreground font-medium leading-relaxed line-clamp-3">
                {featured.data.description}
              </p>
              
              <div class="mt-5 flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-gray-100">
                <div class="flex flex-wrap gap-1.5">
                  {featured.data.tags.slice(0, 4).map((t) => (
                    <span class="rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-[10px] font-medium text-muted-foreground">
                      #{t}
                    </span>
                  ))}
                </div>
                <div class="font-mono text-xs text-muted-foreground">
                  <time datetime={featured.data.publishedAt.toISOString()}>
                    {featured.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                  </time>
                  {" · "}<span class="text-primary font-semibold">{featured.data.author.name}</span>
                </div>
              </div>
            </a>
          </div>
        )}

        <!-- Post Grid -->
        <ul
          id="post-grid"
          class="grid gap-5 sm:grid-cols-2"
          aria-live="polite"
          aria-atomic="true"
        >
          {rest.map((post) => {
            const slug = post.id.replace(/\.md$/, "");
            const readTime = post.data.wordCount ? Math.ceil(post.data.wordCount / 230) : null;
            return (
              <li data-post-cat={post.data.category} class="flex">
                <a
                  href={`/blog/${slug}/`}
                  class="group flex h-full w-full flex-col justify-between rounded-2xl border border-border bg-white p-5 shadow-soft hover:border-accent hover:shadow-elevated transition-all"
                >
                  <div>
                    <div class="mb-3 flex items-center justify-between gap-2">
                      <span class="rounded-md border border-border bg-surface px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-muted-foreground">
                        {categoryLabel[post.data.category]}
                      </span>
                      {readTime && (
                        <span class="font-mono text-[11px] text-muted-foreground font-medium">{readTime} min</span>
                      )}
                    </div>
                    <h2 class="text-sm sm:text-base font-bold leading-snug text-primary group-hover:text-accent transition-colors line-clamp-2">
                      {post.data.title}
                    </h2>
                    <p class="mt-2 text-xs text-muted-foreground font-medium leading-relaxed line-clamp-3">
                      {post.data.description}
                    </p>
                  </div>
                  
                  <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between font-mono text-[10px] text-muted-foreground">
                    <span>
                      {post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                    </span>
                    <span class="text-accent font-bold group-hover:translate-x-0.5 transition-transform">
                      Read article →
                    </span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>

        <!-- Empty state -->
        <p id="no-posts" class="hidden mt-12 text-center text-sm font-medium text-muted-foreground">
          No posts found in this category.
        </p>
      </div>

      <!-- ── RIGHT SIDEBAR (3 Widgets from Sketch) ───────────────────── -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">

          <!-- Widget 1: Free forever CTA -->
          <div class="rounded-2xl border border-border bg-surface p-5 shadow-soft">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-accent block mb-1">
              FREE FOREVER
            </span>
            <h3 class="text-sm font-bold text-primary">
              ZTNA mesh for your whole team
            </h3>
            <p class="mt-1.5 text-xs text-muted-foreground font-medium leading-relaxed">
              WireGuard mesh + DLP + AI Operator. One install command. No credit card.
            </p>
            <a
              href="https://login.quickztna.com/auth"
              class="mt-4 block w-full rounded-full bg-accent py-2.5 text-center text-xs font-bold text-white hover:bg-accent/95 shadow-md shadow-accent/20 transition-all active:scale-95"
            >
              Start free →
            </a>
          </div>

          <!-- Widget 2: Browse by topic -->
          <div class="rounded-2xl border border-border bg-white p-5 shadow-soft">
            <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-widest text-primary">
              Browse by topic
            </p>
            <ul class="space-y-1">
              <li>
                <button
                  data-cat="all"
                  class="cat-btn flex w-full items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold text-primary hover:bg-muted transition-colors text-left cursor-pointer"
                >
                  <span>All posts</span>
                  <span class="font-mono text-[11px] text-muted-foreground font-medium">{allPosts.length}</span>
                </button>
              </li>
              {categories.map((c) => counts[c] > 0 && (
                <li>
                  <button
                    data-cat={c}
                    class="cat-btn flex w-full items-center justify-between rounded-lg px-3 py-2 text-xs font-semibold text-muted-foreground hover:bg-muted hover:text-primary transition-colors text-left cursor-pointer"
                  >
                    <span>{categoryLabel[c]}</span>
                    <span class="font-mono text-[11px] text-muted-foreground font-medium">{counts[c]}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <!-- Widget 3: Latest posts -->
          <div class="rounded-2xl border border-border bg-white p-5 shadow-soft">
            <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-widest text-primary">
              Latest posts
            </p>
            <ul class="space-y-3 divide-y divide-gray-100">
              {allPosts.slice(0, 4).map((post, idx) => {
                const s = post.id.replace(/\.md$/, "");
                return (
                  <li class={idx > 0 ? "pt-3" : ""}>
                    <a href={`/blog/${s}/`} class="group block">
                      <p class="text-xs font-bold leading-snug text-primary group-hover:text-accent line-clamp-2 transition-colors">
                        {post.data.title}
                      </p>
                      <time class="mt-1 block font-mono text-[10px] text-muted-foreground" datetime={post.data.publishedAt.toISOString()}>
                        {post.data.publishedAt.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                      </time>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>

        </div>
      </aside>
    </div>
  </div>
</SiteLayout>

<script>
  // Client-side category filtering
  const allCards = document.querySelectorAll<HTMLElement>("[data-post-cat]");
  const featuredEl = document.getElementById("featured-post");
  const noPostsEl = document.getElementById("no-posts");
  const pills = document.querySelectorAll<HTMLButtonElement>(".cat-pill");
  const sideButtons = document.querySelectorAll<HTMLButtonElement>(".cat-btn");

  const setActive = (activeCat: string) => {
    // Update pill styles
    pills.forEach((btn) => {
      const isActive = btn.dataset.cat === activeCat;
      if (isActive) {
        btn.className = "cat-pill rounded-full border border-accent bg-accent px-4 py-1.5 font-mono text-xs font-bold text-white transition-all shadow-sm active:scale-95 cursor-pointer";
      } else {
        btn.className = "cat-pill rounded-full border border-border bg-white px-4 py-1.5 font-mono text-xs font-semibold text-muted-foreground hover:border-accent hover:text-accent transition-all active:scale-95 cursor-pointer";
      }
    });

    // Update sidebar button styles
    sideButtons.forEach((btn) => {
      const isActive = btn.dataset.cat === activeCat;
      if (isActive) {
        btn.classList.add("bg-accent-light", "text-accent", "font-bold");
        btn.classList.remove("text-muted-foreground", "text-primary");
      } else {
        btn.classList.remove("bg-accent-light", "text-accent", "font-bold");
        btn.classList.add("text-muted-foreground");
      }
    });

    // Show/hide cards
    let visible = 0;
    allCards.forEach((card) => {
      const isCardActive = activeCat === "all" || card.dataset.postCat === activeCat;
      card.style.display = isCardActive ? "" : "none";
      if (isCardActive) visible++;
    });

    if (noPostsEl) noPostsEl.classList.toggle("hidden", visible > 0);
  };

  pills.forEach((btn) => {
    btn.addEventListener("click", () => setActive(btn.dataset.cat ?? "all"));
  });

  sideButtons.forEach((btn) => {
    btn.addEventListener("click", () => setActive(btn.dataset.cat ?? "all"));
  });

  // Initialise from URL param if present
  const params = new URLSearchParams(window.location.search);
  const initCat = params.get("category") ?? "all";
  setActive(initCat);
</script>
