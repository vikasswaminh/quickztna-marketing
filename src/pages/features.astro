---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Button from "@/components/ui/Button.astro";
import {
  ArrowRight,
  Network,
  ShieldCheck,
  Gavel,
  Fingerprint,
  Monitor,
  Database,
  BarChart3,
  Check,
} from "lucide-astro";

const AUTH_URL = "https://login.quickztna.com/auth";

type Feature = {
  name: string;
  desc: string;
  plans: ("free" | "business")[];
};

type Section = {
  n: string;
  title: string;
  blurb: string;
  icon: any;
  features: Feature[];
};

const sections: Section[] = [
  {
    n: "01",
    title: "Networking & Connectivity",
    blurb: "The ZTNA primitives. Ship with every plan, no gate, no trial. This is the foundation.",
    icon: Network,
    features: [
      { name: "WireGuard mesh data plane", desc: "Modern, audited X25519 + ChaCha20-Poly1305 + Poly1305 stack. Direct peer-to-peer where NAT allows; DERP relay fallback (Bangalore + Frankfurt) for CGNAT and symmetric NAT.", plans: ["free", "business"] },
      { name: "MagicDNS", desc: "Every device reachable at <hostname>.<org>.zt.net. Zero DNS config.", plans: ["free", "business"] },
      { name: "DERP relays", desc: "2 regions (Bangalore + Frankfurt) relay when P2P is blocked by symmetric NAT or CGNAT.", plans: ["free", "business"] },
      { name: "STUN NAT discovery", desc: "Automatic public endpoint discovery. Peers find each other without central coordination.", plans: ["free", "business"] },
      { name: "ABAC ACLs", desc: "Rules on user, tag, posture, time of day, country, protocol, port. Evaluated per connection.", plans: ["free", "business"] },
      { name: "Subnet routes", desc: "Advertise + accept CIDR routes. Bridge home labs, cloud VPCs, legacy networks.", plans: ["free", "business"] },
      { name: "Exit nodes", desc: "Route outbound traffic through a chosen peer. Geofence compliance, egress control.", plans: ["free", "business"] },
      { name: "Device posture", desc: "OS version, disk encryption, firewall, antivirus checks. Block non-compliant devices.", plans: ["free", "business"] },
      { name: "Auto-quarantine", desc: "Failed posture → machine isolated automatically. Admin notified.", plans: ["free", "business"] },
      { name: "Tailnet IP allocation", desc: "Atomic 100.64.x.x allocation. Guaranteed no collisions, even under concurrent registration.", plans: ["free", "business"] },
    ],
  },
  {
    n: "02",
    title: "Admin Insights",
    blurb: "Deterministic reports computed from your own tenant data. No model in the decision path.",
    icon: BarChart3,
    features: [
      { name: "Security digest", desc: "24-hour report: machines, threats blocked, compliance rate, JIT requests.", plans: ["free", "business"] },
      { name: "Policy drift detection", desc: "Flags overly permissive ACL rules against a deterministic baseline.", plans: ["free", "business"] },
      { name: "Access heatmap", desc: "Which users touch which resources, when, how often.", plans: ["free", "business"] },
      { name: "Optional LLM summary", desc: "Any insight can be rendered as a written summary — opt-in per request, off by default. The underlying numbers are computed, not generated.", plans: ["free", "business"] },
    ],
  },
  {
    n: "03",
    title: "Security & Threat Detection",
    blurb: "Defense in depth. Shipped as a single agent, not five separate tools to deploy.",
    icon: ShieldCheck,
    features: [
      { name: "Malware detection (file-hash)", desc: "Agents report SHA-256 file hashes; confirmed-malicious hits are recorded and, in enforce mode, quarantine the device.", plans: ["free", "business"] },
    ],
  },
  {
    n: "04",
    title: "Governance & Compliance",
    blurb: "Audit-ready by default. SOC 2 / ISO 27001 / HIPAA artifacts generated, not assembled.",
    icon: Gavel,
    features: [
      { name: "Compliance reports", desc: "One-click SOC 2 / ISO 27001 / HIPAA evidence bundles. Signed, timestamped.", plans: ["free", "business"] },
      { name: "Continuous compliance", desc: "Background rules run daily. Drift flagged before audit time.", plans: ["free", "business"] },
      { name: "JIT access workflow", desc: "Request → approve → time-bounded grant → auto-revoke. Full audit trail.", plans: ["free", "business"] },
      { name: "Access review campaigns", desc: "Periodic campaigns. Approvers confirm / revoke. Everything logged.", plans: ["free", "business"] },
      { name: "Policy version rollback", desc: "Every ACL change versioned. Roll back to any prior version instantly.", plans: ["free", "business"] },
    ],
  },
  {
    n: "05",
    title: "Identity & Provisioning",
    blurb: "Bring your identity provider. SSO, SCIM, OAuth — all free. MFA-ready, device-bound.",
    icon: Fingerprint,
    features: [
      { name: "Email + password", desc: "PBKDF2-SHA256 100K iterations. Timing-safe. Per-email rate-limited.", plans: ["free", "business"] },
      { name: "GitHub / Google OAuth", desc: "One-click sign-in for dev teams. Respects org domains.", plans: ["free", "business"] },
      { name: "OIDC SSO", desc: "Okta, Azure AD, Google Workspace, Auth0, any OIDC-compliant IdP. (SAML login is temporarily disabled pending a security fix — use OIDC with the same providers.)", plans: ["free", "business"] },
      { name: "TOTP MFA", desc: "RFC 6238. Replay-protected (used codes cached 90s). 10 backup codes per user.", plans: ["free", "business"] },
      { name: "SCIM 2.0 provisioning", desc: "Automated user lifecycle from Okta, Azure AD. Groups sync.", plans: ["free", "business"] },
      { name: "Org groups (departments)", desc: "Sub-tenants within an org. Scoped ACLs, isolated users.", plans: ["free", "business"] },
    ],
  },
  {
    n: "06",
    title: "Endpoint Management",
    blurb: "One agent — remote diagnostics, secure shell, device lifecycle, OTA updates.",
    icon: Monitor,
    features: [
      { name: "Remote management", desc: "Run safe diagnostic commands across the fleet. Whitelisted verbs only.", plans: ["free", "business"] },
      { name: "Remote shell", desc: "Browser-based shell for diagnostics, opened with a single-use ticket. Included on every plan, not gated behind an enterprise tier.", plans: ["free", "business"] },
      { name: "Device wipe / lock", desc: "Admin can lock or wipe stolen/lost devices with signed commands.", plans: ["free", "business"] },
      { name: "OTA agent updates", desc: "Self-update via signed releases. Controlled by client_versions table.", plans: ["free", "business"] },
    ],
  },
  {
    n: "07",
    title: "Data & Access Layer",
    blurb: "Protect internal apps, databases, Kubernetes, cloud VPCs — through the same tailnet.",
    icon: Database,
    features: [
      { name: "Database access broker", desc: "Register PG/MySQL/Mongo/Redis. JIT credentials, scoped queries, audit.", plans: ["free", "business"] },
      { name: "Kubernetes access", desc: "Identity-scoped kubeconfig. RBAC inherited from your org roles.", plans: ["free", "business"] },
      { name: "App connector", desc: "Protect internal web apps (Jira, Jenkins, Grafana) with reverse proxy + ZTNA auth.", plans: ["free", "business"] },
      { name: "Webhook forwarder", desc: "Inbound webhooks delivered through the mesh to private targets.", plans: ["free", "business"] },
      { name: "Terraform provider", desc: "Full IaC for machines, ACLs, DNS, users, settings. GitOps-friendly.", plans: ["free", "business"] },
    ],
  },
];

const planLabels: Record<string, { label: string; style: string }> = {
  free: { label: "Free", style: "border-success/30 bg-success/5 text-success" },
  business: { label: "Business", style: "border-primary/30 bg-primary/5 text-primary" },
};

function lowestPlan(plans: Feature["plans"]): "free" | "business" {
  if (plans.includes("free")) return "free";
  return "business";
}

// FAQ tailored to the features page — the questions buyers actually ask after
// scanning the matrix. FAQPage schema makes these eligible for Google's
// "People also ask" panel and for Perplexity / Claude / ChatGPT citation.
const featuresFaq = [
  {
    q: "Is the WireGuard encryption available on every plan?",
    a: "Yes. WireGuard's X25519 + ChaCha20-Poly1305 + Poly1305 cipher suite is used on every tunnel, on every plan including Free. It is not a paid feature, not behind a flag, and cannot be downgraded. Key rotation follows the WireGuard spec.",
  },
  {
    q: "What is the difference between the Free and Business plans?",
    a: "Features are identical — both plans include the entire platform (WireGuard ZTNA mesh, ABAC + device posture, JIT access, access reviews, compliance reports, remote shell, SSO, SCIM, and more). The only difference is scale: Free covers 5 users and up to 100 devices; Business ($10 per user per month) is unlimited users billed per seat, with up to 10,000 devices. Billing is per user, never per device — you pay to grow, not to unlock features.",
  },
  {
    q: "Does QuickZTNA support OIDC SSO?",
    a: "Yes. OIDC SSO works on every plan including Free, with pre-configured connectors for Google Workspace, Microsoft Entra (formerly Azure AD), Okta, Authentik, GitHub, and any standards-compliant identity provider. SCIM 2.0 provisioning and TOTP multi-factor authentication are included on every plan. SAML login is temporarily disabled pending a security fix — the same identity providers work over OIDC in the meantime.",
  },
  {
    q: "Can QuickZTNA replace my existing VPN?",
    a: "Yes, for most workloads. QuickZTNA is a mesh VPN with WireGuard data plane plus the full ZTNA feature set (identity-based ACLs, continuous device posture, audit log retention, JIT access with approvals and policy rollback). Teams typically migrate user-VPN, site-to-site, and bastion-host access. Hardware VPN concentrators and IPsec-specific compliance scenarios may still need a separate solution.",
  },
  {
    q: "Which platforms does QuickZTNA support?",
    a: "Linux, macOS, and Windows. Native binaries for x86_64 (amd64) and arm64, plus armv7 on Linux. Headless installs with pre-authentication keys are supported for servers and containers. There are no mobile (iOS/Android) clients today.",
  },
  {
    q: "What compliance certifications does QuickZTNA support?",
    a: "We offer a GDPR-aligned DPA and sign HIPAA Business Associate Agreements on the Business plan. SOC 2 Type II and ISO 27001 certifications are in progress with target completion in 2026.",
  },
  {
    q: "Is there a self-hosted or air-gapped deployment option?",
    a: "Not today — QuickZTNA is a fully managed cloud service. If self-hosted or air-gapped deployment is a requirement for your organization, contact sales@quickztna.com to discuss your needs and our roadmap.",
  },
  {
    q: "Does any tenant data go to a third-party AI provider?",
    a: "Not by default. Admin Insights are computed deterministically from your own tenant data — no model sits in the decision path. A written summary of an insight can be requested explicitly per call, and only then is that report's content sent to the LLM provider; leave it off and no tenant data reaches a third-party model at all.",
  },
];

const featuresFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: featuresFaq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const featuresWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://www.quickztna.com/features/",
  url: "https://www.quickztna.com/features/",
  name: "QuickZTNA features — ZTNA mesh, ABAC policies, device posture",
  description: "Complete feature matrix across seven categories: networking, admin insights, security, governance, identity, endpoint management, and data access.",
  isPartOf: { "@id": "https://www.quickztna.com/#website" },
  about: { "@type": "Thing", name: "Zero Trust Network Access features" },
  primaryImageOfPage: { "@type": "ImageObject", url: "https://www.quickztna.com/favicon.svg" },
};

const featuresBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://www.quickztna.com" },
    { "@type": "ListItem", position: 2, name: "Features", item: "https://www.quickztna.com/features/" },
  ],
};
---
<SiteLayout
  title="Features — QuickZTNA: ZTNA mesh, ABAC policies, device posture"
  description="Complete QuickZTNA feature matrix: WireGuard mesh, ABAC policies with device posture, JIT access governance, SSO + SCIM, Terraform."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(featuresWebPageSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(featuresFaqSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(featuresBreadcrumbSchema)} is:inline />
  </Fragment>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-hero border-b border-border">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8 lg:py-28">
      <p class="font-mono text-xs uppercase tracking-wider text-primary">The platform</p>
      <h1 class="mx-auto mt-4 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
        One agent. <span class="text-gradient">Every layer</span> of access.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        QuickZTNA consolidates your VPN, SSO gateway, access-governance workflow,
        and Terraform state into one tailnet. Every feature below is shipped today and available on
        both plans — no coming-soon shelf, and nothing here is gated behind an upgrade.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button size="lg" href={AUTH_URL} class="h-11 px-6 font-medium">
          Start free
          <ArrowRight class="ml-1.5 h-4 w-4" />
        </Button>
        <Button size="lg" variant="outline" href="/pricing" class="h-11 px-6 font-medium">
          Compare plans
        </Button>
      </div>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-xs">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-success/30 bg-success/5 px-2.5 py-1 font-mono font-medium text-success">
          <span class="h-1.5 w-1.5 rounded-full bg-success"></span>Free — 5 users, every feature
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 bg-primary/5 px-2.5 py-1 font-mono font-medium text-primary">
          <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Business — $10 / user / mo
        </span>
      </div>
    </div>
  </section>

  <!-- FEATURE SECTIONS -->
  {sections.map((s, i) => (
    <section class={`border-b border-border ${i % 2 === 0 ? "" : "bg-surface"}`}>
      <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
          <div>
            <div class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-elevated px-2.5 py-1 font-mono text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
              <s.icon class="h-3.5 w-3.5 text-primary" />
              Category {s.n}
            </div>
            <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{s.title}</h2>
            <p class="mt-3 text-muted-foreground">{s.blurb}</p>
            <p class="mt-4 font-mono text-xs text-muted-foreground">{s.features.length} features</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {s.features.map((f) => {
              const lp = lowestPlan(f.plans);
              return (
                <div class="group relative overflow-hidden rounded-xl border border-border bg-surface-elevated p-5 shadow-soft transition-all hover:border-primary/30 hover:shadow-elevated">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-sm font-semibold leading-snug">{f.name}</h3>
                    <span class={`shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider ${planLabels[lp].style}`}>
                      {planLabels[lp].label}
                    </span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-muted-foreground" set:html={f.desc}></p>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- FAQ — visible content backing the FAQPage schema for AEO retrieval -->
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="font-mono text-xs uppercase tracking-wider text-primary">FAQ</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Common questions about QuickZTNA features</h2>
    </div>
    <div class="mt-10 grid gap-3">
      {featuresFaq.map((f) => (
        <details class="group rounded-xl border border-border bg-surface-elevated shadow-soft transition-all open:shadow-elevated">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-foreground list-none [&::-webkit-details-marker]:hidden">
            <span>{f.q}</span>
            <svg class="h-4 w-4 shrink-0 transition-transform group-open:rotate-45 text-muted-foreground" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="10" y1="4" x2="10" y2="16"></line>
              <line x1="4" y1="10" x2="16" y2="10"></line>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-primary to-chart-2 p-12 text-primary-foreground shadow-elevated lg:p-16">
        <div class="absolute inset-0 bg-grid opacity-10"></div>
        <div class="relative grid items-center gap-8 lg:grid-cols-[1.5fr_1fr]">
          <div>
            <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
              See exactly what's on each plan.
            </h2>
            <p class="mt-3 max-w-xl text-primary-foreground/85">
              Full per-feature comparison. Honest limits. No surprise upsells.
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <Button size="lg" variant="secondary" href="/pricing" class="h-11 font-medium">
              Compare plans
              <ArrowRight class="ml-1.5 h-4 w-4" />
            </Button>
            <Button size="lg" href={AUTH_URL} class="h-11 font-medium bg-primary-foreground/10 border border-primary-foreground/30 text-primary-foreground hover:bg-primary-foreground/20">
              Start free · 5 users
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
