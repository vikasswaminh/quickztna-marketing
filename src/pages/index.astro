<script>
  // Tab switching
  function initTabs() {
    const nav = document.getElementById("tab-nav");
    if (!nav) return;
    nav.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const tabId = btn.getAttribute("data-tab")!;
        // Update button states
        nav.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-selected", String(active));
          b.className = b.className
            .replace(/bg-primary text-white shadow-sm|text-gray-500 hover:text-gray-700 hover:bg-gray-50/, "")
            .trim();
          b.className += active
            ? " bg-primary text-white shadow-sm"
            : " text-gray-500 hover:text-gray-700 hover:bg-gray-50";
        });
        // Show/hide panels
        document.querySelectorAll("[role='tabpanel']").forEach((panel) => {
          panel.classList.toggle("hidden", panel.id !== `tab-panel-${tabId}`);
        });
      });
    });
  }

  // Billing toggle
  function initBilling() {
    const monthly = document.getElementById("billing-monthly");
    const annual = document.getElementById("billing-annual");
    if (!monthly || !annual) return;

    const activeCls = "bg-primary text-white";
    const inactiveCls = "border border-gray-200 bg-white text-gray-600 hover:bg-gray-50";

    monthly.addEventListener("click", () => {
      monthly.className = monthly.className.replace(inactiveCls, "").trim() + " " + activeCls;
      annual.className = annual.className.replace(activeCls, "").trim() + " " + inactiveCls;
    });
    annual.addEventListener("click", () => {
      annual.className = annual.className.replace(inactiveCls, "").trim() + " " + activeCls;
      monthly.className = monthly.className.replace(activeCls, "").trim() + " " + inactiveCls;
    });
  }

  initTabs();
  initBilling();
  document.addEventListener("astro:after-swap", () => {
    initTabs();
    initBilling();
  });
</script>
