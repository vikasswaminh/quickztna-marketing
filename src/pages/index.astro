---
import SiteLayout from "@/layouts/SiteLayout.astro";

const AUTH_URL = "https://login.quickztna.com/auth";
const QUICKSTART_URL = "https://www.quickztna.com/guide/quickstart/";
const INSTALL_CMD = "curl -fsSL https://login.quickztna.com/install.sh | ZTNA_AUTH_KEY=tskey-auth-xxx sh";

const proofPoints = [
  "Setup in 2 minutes",
  "WireGuard mesh encryption",
  "SOC 2 Type II compliant",
  "99.99% mesh uptime",
];

const capabilities = [
  {
    label: "AI Operator",
    title: "AI Operator",
    desc: "Dynamic policies, database sync, preview before deploy, rollback state snapshot.",
    pills: ["Preview", "Snapshot", "1-click", "Audited"],
  },
  {
    label: "NAT & DERP relays",
    title: "WireGuard P2P with DERP fallback",
    desc: "Direct peer-to-peer tunnels wherever NAT allows. Two global DERP relays cover CGNAT and symmetric-NAT automatically.",
  },
  {
    label: "AI Security",
    title: "Natural-language ACLs",
    desc: 'Natural-language interface to define policies. "Laptops can SSH to prod 9–6 IST." Powered by Claude.',
  },
  {
    label: "ABAC policies",
    title: "ABAC policies",
    desc: "Rules keyed on user, tag, device posture, time of day, country, and port. Evaluated per connection.",
  },
  {
    label: "DNS & Routing",
    title: "MagicDNS & subnet routes",
    desc: "Every device reachable at name.org.zt.net. Advertise subnet routes & exit nodes.",
  },
  {
    label: "JIT Access",
    title: "JIT access",
    desc: "JIT access request, instant admin approval flow, and automatic expiration timers.",
  },
  {
    label: "SSO & SCIM",
    title: "SSO + SCIM 2.0",
    desc: "SSO + SCIM 2.0 integrations for Google, Okta, and Azure AD. Device-bound refresh tokens.",
  },
  {
    label: "Secrets",
    title: "Secrets vault",
    desc: "AES-256-GCM encrypted secrets with rotation policies. Integrated directly inside agent.",
  },
  {
    label: "Developer",
    title: "Terraform + API",
    desc: "57 REST endpoints. Full Terraform provider for machines, ACLs, DNS, users. GitOps network.",
  },
  {
    label: "Network",
    title: "Network Security",
    desc: "Evaluate and secure node access dynamically. Block contractor egress automatically.",
  },
  {
    label: "Routing",
    title: "Advanced Routing",
    desc: "Advanced routing configurations support exit nodes, local relays, and multi-cloud.",
  },
  {
    label: "IAM",
    title: "IAM Integrations",
    desc: "Integrate with existing Identity Access Management tools, role policies, and tags.",
  },
];

const steps = [
  {
    num: "01",
    title: "Issue one auth key",
    sub: "Admin Dashboard",
    desc: "Generate a reusable auth key with specific node tags in the admin console. Hook it directly into your identity provider policies.",
    cmd: "ztna auth-key create --reusable",
  },
  {
    num: "02",
    title: "Pipe the installer everywhere",
    sub: "Your Servers & VMs",
    desc: "Install the lightweight ztna agent using a single curl piped command on any Ubuntu, Debian, CentOS, macOS, or Windows machine.",
    cmd: "curl -fsSL https://install.quickztna.com | ZTNA_AUTH_KEY=tskey-auth-xxx sh",
  },
  {
    num: "03",
    title: "You're on the mesh",
    sub: "Frictionless Access",
    desc: "Every device joins your tailnet over a WireGuard mesh tunnel. Reachable by MagicDNS name. ABAC policies + device posture enforced on every connection.",
    cmd: "ssh prod-db.acme.zt.net",
  },
];

const plans = [
  {
    name: "FREE",
    price: "$0",
    per: "/user",
    highlight: false,
    features: ["Free for 5 users", "Up to 100 devices", "Every feature included", "Community support"],
    cta: "Start Free →",
    ctaHref: AUTH_URL,
  },
  {
    name: "BUSINESS",
    badge: "MOST POPULAR",
    price: "$10",
    per: "/user /month",
    highlight: true,
    features: ["Unlimited access", "Up to 10,000+ devices", "Priority email support", "All features included"],
    cta: "Choose Business →",
    ctaHref: AUTH_URL,
  },
];

const homepageFaq = [
  {
    q: "What is QuickZTNA?",
    a: "QuickZTNA is the Remote Workforce Security OS — a Zero Trust Network Access platform that connects laptops, servers, and containers into a single encrypted private mesh network. Every connection is authenticated against your identity provider, authorized against ABAC policies + continuous device posture, and encrypted by WireGuard. An AI Operator previews, applies, and reverts ACL + firewall + policy changes. Free for up to 5 users, forever — every feature included.",
  },
  {
    q: "How is QuickZTNA different from Tailscale?",
    a: "Both are mesh VPN products built on WireGuard. Tailscale focuses on the mesh-VPN primitive; QuickZTNA ships a fuller workforce-security suite in-product: DLP (filesystem file scanning), CASB with approval workflow, workforce analytics, software inventory, user-risk scoring, continuous device posture, and an AI Operator that previews/applies/reverts ACL + firewall + policy changes.",
  },
  {
    q: "Is QuickZTNA really free, forever?",
    a: "Yes. The Free plan covers up to 5 users (and up to 100 devices) with no trial timer, no credit card requirement — and it includes every feature: WireGuard-encrypted mesh, MagicDNS, ABAC policies, device posture, DNS filtering, AI assistant, remote shell, DLP, CASB, SCIM, remote desktop, and more. The plan never expires; upgrade to Business only when you need more seats.",
  },
  {
    q: "How fast can I deploy QuickZTNA across my team?",
    a: "Roughly two minutes per device for an interactive install, or seconds per device for fleet rollouts with pre-authentication keys. The install is one command (curl on Linux/macOS, PowerShell on Windows). The client auto-registers with your organization and joins the mesh.",
  },
  {
    q: "Does QuickZTNA work behind NAT, CGNAT, and corporate firewalls?",
    a: "Yes. The client only requires outbound HTTPS (TCP/443) to *.quickztna.com — no inbound ports, no firewall changes, no port forwarding. Peer-to-peer connections use UDP NAT traversal where possible; when UDP is blocked by symmetric NAT, traffic transparently falls back to an encrypted relay.",
  },
  {
    q: "What identity providers does QuickZTNA integrate with?",
    a: "Every major IdP that speaks OIDC or SAML 2.0: Google Workspace, Microsoft Entra (Azure AD), Okta, Authentik, GitHub, plus generic OIDC for any standards-compliant provider. SCIM 2.0 provisioning is included on every plan.",
  },
  {
    q: "Is QuickZTNA SOC 2 compliant?",
    a: "We offer a GDPR-aligned DPA and sign HIPAA Business Associate Agreements on the Business plan. SOC 2 Type II and ISO 27001 certifications are active with continuous compliance audits.",
  },
  {
    q: "Can QuickZTNA be self-hosted?",
    a: "QuickZTNA is primarily a fully managed cloud service. If self-hosting is a requirement for your organization, contact sales@quickztna.com to discuss enterprise on-prem options.",
  },
];

const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homepageFaq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "QuickZTNA",
  description: "Remote Workforce Security OS. WireGuard mesh + ABAC policies + continuous device posture + DLP + AI Operator. Free for up to 5 users forever.",
  applicationCategory: "SecurityApplication",
  applicationSubCategory: "Zero Trust Network Access",
  operatingSystem: "Linux, macOS, Windows",
  url: "https://www.quickztna.com",
  image: "https://www.quickztna.com/favicon.svg",
};
---

<SiteLayout
  title="QuickZTNA — The Remote Workforce Security OS · Zero Trust Network Access"
  description="The Remote Workforce Security OS. Connect employees, services and code areas through encrypted private links. WireGuard mesh ZTNA + ABAC + DLP + AI Operator."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(homepageFaqSchema)} is:inline />
  </Fragment>

  <!-- ═══════════════════════════════════════════════
       HERO (Centered with Red-Orange Highlight)
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white bg-grid border-b border-border pt-16 pb-12 sm:pt-20 sm:pb-14">
    <!-- Center glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-accent/5 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8 flex flex-col items-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent-light px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-accent shadow-sm">
        <span class="flex h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        Zero Trust security without the infrastructure headache
      </div>

      <!-- Main Headline -->
      <h1 class="mt-6 text-4xl font-bold leading-[1.12] tracking-tight text-primary sm:text-6xl lg:text-6xl">
        The <span class="font-serif italic font-normal text-accent">Remote Workforce</span><br class="hidden sm:inline" />
        Security OS.
      </h1>

      <!-- Subtitle -->
      <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-muted-foreground font-medium">
        WireGuard mesh ZTNA + ABAC. Workforce DLP, device posture, software inventory, user-risk scoring. AI Operator previews, applies, and reverts ACL + firewall + policy changes. Free forever for up to 5 users.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
        <a
          href={AUTH_URL}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-accent px-7 py-3 text-sm font-bold text-white transition-all hover:bg-accent/95 shadow-md shadow-accent/20 active:scale-95"
        >
          Start free — no card required
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a
          href={QUICKSTART_URL}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-border bg-white px-6 py-3 text-sm font-semibold text-primary transition-all hover:border-accent hover:bg-muted shadow-soft active:scale-95"
        >
          Read the 2-minute quickstart
        </a>
      </div>

      <!-- Proof Points Checklist -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-mono font-medium text-muted-foreground">
        {proofPoints.map((p) => (
          <div class="flex items-center gap-1.5">
            <span class="text-accent font-bold">✓</span> {p}
          </div>
        ))}
      </div>

      <!-- Trust Banner -->
      <div class="mt-8 w-full max-w-3xl rounded-xl border border-border bg-surface px-5 py-3 shadow-soft">
        <p class="text-xs text-primary font-medium text-center leading-normal">
          <strong class="text-primary font-bold">45,000+ mesh nodes active</strong> at <strong class="text-primary font-bold">800+ enterprise companies</strong> including Cisco, HCL, Akamai, Barracuda, Aryaka, Movate. <span class="underline decoration-accent/40 font-semibold cursor-default">Lifetime network access</span> + <span class="underline decoration-accent/40 font-semibold cursor-default">24/7 real-time threat detection</span>.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FEATURE STRIP
  ═══════════════════════════════════════════════ -->
  <section class="border-b border-border bg-surface py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-border bg-white p-4 sm:p-6 shadow-soft flex flex-col lg:flex-row items-center justify-between divide-y lg:divide-y-0 lg:divide-x divide-gray-100">
        {[
          { title: "WireGuard®", desc: "High-performance mesh", icon: "🌐" },
          { title: "Zero Trust", desc: "Verify every request", icon: "🛡️" },
          { title: "ABAC", desc: "Identity & context aware", icon: "🔑" },
          { title: "AI Operator", desc: "Policies & path lifecycle", icon: "✨" },
          { title: "Built for Scale", desc: "From 10 to 1000+ devices", icon: "📈" },
        ].map((f) => (
          <div class="flex items-center gap-3.5 px-4 lg:px-6 py-3 lg:py-0 w-full lg:w-auto flex-1">
            <span class="text-xl shrink-0">{f.icon}</span>
            <div>
              <h4 class="text-xs font-bold text-primary">{f.title}</h4>
              <p class="text-[11px] text-muted-foreground font-medium">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       HOW IT WORKS
  ═══════════════════════════════════════════════ -->
  <section class="border-b border-border bg-white py-12 md:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center mb-10">
        <span class="text-accent font-bold tracking-widest text-[11px] uppercase font-mono block mb-2">HOW QUICKZTNA WORKS</span>
        <h2 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl">
          One unified control plane. Three simple stages.
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {[
          {
            n: "01",
            title: "Verify",
            desc: "Verify user identity via SSO/MFA and validate dynamic device posture indicators before allowing access.",
          },
          {
            n: "02",
            title: "Authorize",
            desc: "Evaluate access request using Attribute-Based Access Control (ABAC), groups, user tags, and device flags.",
          },
          {
            n: "03",
            title: "Connect",
            desc: "Grant access using state-of-the-art P2P encrypted WireGuard mesh tunnels directly to target servers.",
          },
        ].map((s) => (
          <div class="relative overflow-hidden rounded-2xl border border-border bg-white p-6 shadow-soft transition-all hover:border-accent group">
            <div class="absolute -right-4 -top-6 text-accent/5 font-extrabold text-[110px] select-none pointer-events-none group-hover:text-accent/10 transition-colors font-mono">
              {s.n}
            </div>
            <div class="relative z-10">
              <div class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-accent-light text-accent font-mono font-bold text-xs mb-4">
                {s.n}
              </div>
              <h3 class="text-lg font-bold text-primary mb-2">{s.title}</h3>
              <p class="text-xs leading-relaxed text-muted-foreground font-medium">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PLATFORM CAPABILITIES (12 Cards Grid)
  ═══════════════════════════════════════════════ -->
  <section class="border-b border-border bg-surface py-12 md:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center mb-10">
        <span class="text-accent font-bold tracking-widest text-[11px] uppercase font-mono block mb-2">PLATFORM CAPABILITIES</span>
        <h2 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl">
          Everything your workforce needs
        </h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((c) => (
          <div class="flex flex-col justify-between rounded-2xl border border-border bg-white p-5 shadow-soft transition-all hover:border-accent group">
            <div>
              <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-accent block mb-2">{c.label}</span>
              <h3 class="text-sm font-bold text-primary mb-1.5">{c.title}</h3>
              <p class="text-xs leading-relaxed text-muted-foreground font-medium">{c.desc}</p>
            </div>
            {c.pills && (
              <div class="mt-4 flex flex-wrap gap-1.5 pt-3 border-t border-gray-100">
                {c.pills.map((pill) => (
                  <span class="rounded bg-muted px-2 py-0.5 font-mono text-[10px] font-bold text-primary border border-border">
                    {pill}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SETUP TIMELINE
  ═══════════════════════════════════════════════ -->
  <section class="border-b border-border bg-white py-12 md:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[40%_60%] items-center">
        <div>
          <span class="text-accent font-bold tracking-widest text-[11px] uppercase font-mono block mb-2">SUPER EASY SETUP</span>
          <h2 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl leading-tight">
            Zero infrastructure.<br />Up in minutes.
          </h2>
          <p class="mt-4 text-xs sm:text-sm text-muted-foreground font-medium leading-relaxed max-w-sm">
            QuickZTNA is an overlay network. It doesn't require firewall changes, public IPs, or complex routing table configurations.
          </p>
          <a href={QUICKSTART_URL} class="mt-6 inline-flex items-center gap-1.5 text-xs font-bold text-accent hover:underline">
            Read the 2-minute quickstart guide →
          </a>
        </div>

        <div class="space-y-4">
          {steps.map((s) => (
            <div class="rounded-2xl border border-border bg-surface p-5 shadow-soft transition-all hover:border-accent">
              <div class="flex items-start gap-4">
                <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent text-white font-mono text-xs font-bold">
                  {s.num}
                </div>
                <div class="flex-1 space-y-1.5">
                  <span class="font-mono text-[9px] font-bold uppercase tracking-widest text-muted-foreground block">{s.sub}</span>
                  <h3 class="text-sm font-bold text-primary">{s.title}</h3>
                  <p class="text-xs text-muted-foreground font-medium leading-relaxed">{s.desc}</p>
                  <div class="mt-2 rounded-lg bg-primary text-white p-2.5 font-mono text-[11px] flex items-center justify-between">
                    <span class="overflow-x-auto whitespace-nowrap text-gray-200">
                      <span class="text-accent font-bold">$</span> {s.cmd}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PRICING + FAQ
  ═══════════════════════════════════════════════ -->
  <section class="border-b border-border bg-surface py-12 md:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">

        <!-- Left: Pricing -->
        <div>
          <span class="text-accent font-bold tracking-widest text-[11px] uppercase font-mono block mb-2">TRANSPARENT PLANS</span>
          <h2 class="text-3xl font-bold text-primary tracking-tight mb-6">Simple, predictable pricing.</h2>

          <div class="grid gap-4 sm:grid-cols-2">
            {plans.map((p) => (
              <div class={`flex flex-col justify-between rounded-2xl border p-6 transition-all ${p.highlight ? "border-accent bg-primary text-white shadow-elevated" : "border-border bg-white shadow-soft"}`}>
                <div>
                  {p.highlight && p.badge && (
                    <span class="inline-block rounded-full bg-accent px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-white mb-3">
                      {p.badge}
                    </span>
                  )}
                  <p class={`font-mono text-xs font-bold uppercase tracking-wider ${p.highlight ? "text-gray-300" : "text-muted-foreground"}`}>{p.name}</p>
                  <div class="mt-3 flex items-baseline gap-1">
                    <span class={`text-4xl font-bold ${p.highlight ? "text-white" : "text-primary"}`}>{p.price}</span>
                    <span class={`text-xs ${p.highlight ? "text-gray-300" : "text-muted-foreground"}`}>{p.per}</span>
                  </div>
                  <ul class="mt-5 space-y-2">
                    {p.features.map((f) => (
                      <li class={`flex items-center gap-2 text-xs font-medium ${p.highlight ? "text-gray-200" : "text-gray-600"}`}>
                        <span class="text-accent font-bold">✓</span> {f}
                      </li>
                    ))}
                  </ul>
                </div>
                <a
                  href={p.ctaHref}
                  class={`mt-6 flex items-center justify-center rounded-full py-2.5 text-xs font-bold transition-all ${p.highlight ? "bg-accent text-white hover:bg-accent/95 shadow-md shadow-accent/20" : "bg-accent-light text-accent border border-accent/20 hover:bg-accent hover:text-white"}`}
                >
                  {p.cta}
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: FAQ -->
        <div>
          <span class="text-accent font-bold tracking-widest text-[11px] uppercase font-mono block mb-2">COMMON QUESTIONS</span>
          <h2 class="text-3xl font-bold text-primary tracking-tight mb-6">Frequently asked questions.</h2>
          <div class="space-y-2.5">
            {homepageFaq.slice(0, 5).map((f) => (
              <details class="group rounded-xl border border-border bg-white shadow-soft transition-all open:shadow-elevated">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-xs sm:text-sm font-semibold text-primary [&::-webkit-details-marker]:hidden">
                  <span>{f.q}</span>
                  <span class="text-accent font-bold transition-transform group-open:rotate-45">+</span>
                </summary>
                <div class="px-5 pb-4 text-xs leading-relaxed text-muted-foreground font-medium border-t border-gray-50 pt-2">
                  {f.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA BANNER (Midnight Navy with Red-Orange CTA)
  ═══════════════════════════════════════════════ -->
  <section class="bg-primary py-12 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between gap-6 text-center sm:flex-row sm:text-left">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-accent mb-2">
            Instant mesh deploy
          </span>
          <h2 class="text-2xl font-bold text-white sm:text-3xl">Ready to secure your workforce?</h2>
          <p class="mt-1 text-xs text-gray-300">Free forever for up to 5 users. Upgrade only when you grow.</p>
        </div>
        <a
          href={AUTH_URL}
          class="inline-flex shrink-0 items-center gap-2 rounded-full bg-accent hover:bg-accent/95 px-7 py-3 text-xs font-bold text-white transition-all shadow-lg shadow-accent/25 active:scale-95"
        >
          Start free — no card required
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
