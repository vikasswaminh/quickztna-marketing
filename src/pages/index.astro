---
import SiteLayout from "@/layouts/SiteLayout.astro";

const AUTH_URL = "https://login.quickztna.com/auth";

// FAQ data — kept for schema
const homepageFaq = [
  {
    q: "What is QuickZTNA?",
    a: "QuickZTNA is the Remote Workforce Security OS — a Zero Trust Network Access platform that connects laptops, servers, and containers into a single encrypted private mesh network. Every connection is authenticated against your identity provider, authorized against ABAC policies + continuous device posture, and encrypted by WireGuard. An AI Operator previews, applies, and reverts ACL + firewall + policy changes. Free for up to 5 users, forever — every feature included.",
  },
  {
    q: "How is it different from Tailscale?",
    a: "Both are mesh VPN products built on WireGuard. Tailscale focuses on the mesh-VPN primitive; QuickZTNA ships a fuller workforce-security suite in-product: DLP, CASB, workforce analytics, software inventory, user-risk scoring, continuous device posture, and an AI Operator.",
  },
  {
    q: "Is QuickZTNA made for?",
    a: "QuickZTNA is built for teams of any size — from indie founders and homelabs to Fortune 500 pilots. Free forever for up to 5 users. Every feature included on every plan.",
  },
  {
    q: "How fast can I deploy it?",
    a: "Roughly two minutes per device for an interactive install, or seconds per device for fleet rollouts with pre-authentication keys.",
  },
  {
    q: "Does it work behind NAT?",
    a: "Yes. The client only requires outbound HTTPS (TCP/443). Peer-to-peer connections use UDP NAT traversal; when blocked, traffic falls back to an encrypted relay (DERP) in Bangalore or Frankfurt.",
  },
  {
    q: "Which identity providers are supported?",
    a: "Google Workspace, Microsoft Entra, Okta, Authentik, GitHub, plus any OIDC/SAML 2.0-compliant provider. SCIM 2.0 provisioning is included on every plan.",
  },
  {
    q: "Is my data secure?",
    a: "Yes. Every tunnel uses WireGuard (X25519 + ChaCha20-Poly1305). Secrets are AES-256-GCM encrypted. We offer a GDPR-aligned DPA and sign HIPAA BAAs on Business.",
  },
];

const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homepageFaq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "QuickZTNA",
  description: "Remote Workforce Security OS. WireGuard mesh ZTNA + workforce DLP + continuous device posture + analytics + an AI Operator.",
  applicationCategory: "SecurityApplication",
  operatingSystem: "Linux, macOS, Windows",
  url: "https://www.quickztna.com",
  offers: [
    { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD" },
    { "@type": "Offer", name: "Business", price: "10", priceCurrency: "USD" },
  ],
};

// Workforce feature tabs data
const workforceTabs = [
  {
    id: "ai-security",
    label: "AI Security",
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    features: ["AI Operator", "Natural Language Q&A", "Policy Insight Preview", "One-Click Rollback"],
    cta: "Explore AI Security →",
    ctaHref: "/features",
  },
  {
    id: "networking",
    label: "Networking",
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    features: ["WireGuard Mesh", "TCP Protector", "Magic DNS", "Split Tunneling", "Failover"],
    cta: "Explore Networking →",
    ctaHref: "/features",
  },
  {
    id: "zero-trust",
    label: "Zero Trust",
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    features: ["Identity & Device", "Device Posture", "JIT Access", "Auto Quarantine", "Session Tracking", "Continuous Verification"],
    cta: "Explore Zero Trust →",
    ctaHref: "/features",
  },
  {
    id: "workforce-security",
    label: "Workforce Security",
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    features: ["SSO", "CASB", "User Risk Score", "Session Inventory", "Behavior Tracking", "Anomaly Shield"],
    cta: "Explore Security →",
    ctaHref: "/features",
  },
  {
    id: "devops",
    label: "DevOps",
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    features: ["SIEM / XDR", "SOAI Provisioning", "Logs / DNA", "Google Workspace", "Enable / Network"],
    cta: "Explore DevOps →",
    ctaHref: "/features",
  },
  {
    id: "infrastructure",
    label: "Infrastructure",
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    features: ["Private SaaS", "RUDDERSTACK Access", "Database Access", "Serverless Provision", "BYOF / BYOK"],
    cta: "Explore Infra →",
    ctaHref: "/features",
  },
];

// Pricing plans
const plans = [
  {
    name: "FREE",
    price: "$0",
    per: "/user",
    highlight: false,
    features: ["Free for 5 users", "Up to 10 devices", "Every feature included", "Community support"],
    cta: "Start Free →",
    ctaHref: AUTH_URL,
  },
  {
    name: "BUSINESS",
    badge: "MOST POPULAR",
    price: "$10",
    per: "/user /month",
    highlight: true,
    features: ["Unlimited access", "Up to 10,000+ devices", "Priority email support", "All features included"],
    cta: "Choose Business →",
    ctaHref: AUTH_URL,
  },
];
---

<SiteLayout
  title="QuickZTNA — Zero Trust Security Without the Infrastructure Headache"
  description="Connect employees, services and code areas through encrypted private links. Better private access controls. Free forever for up to 5 users."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(homepageFaqSchema)} is:inline />
  </Fragment>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white">
    <!-- Subtle grid background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#f0fdf480_1px,transparent_1px),linear-gradient(to_bottom,#f0fdf480_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 pt-16 pb-20 sm:px-6 lg:px-8 lg:pt-20 lg:pb-28">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">

        <!-- Left: copy -->
        <div>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            REMOTE WORKFORCE SECURITY OS
          </div>

          <h1 class="mt-5 text-4xl font-bold leading-[1.08] tracking-tight text-gray-900 sm:text-5xl">
            Zero Trust security<br />
            without the<br />
            <span class="text-primary">infrastructure</span> headache.
          </h1>

          <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground">
            Connect employees, services and code areas through encrypted private links. Better private access controls.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href={AUTH_URL}
              class="inline-flex items-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-primary/90 hover:shadow-glow"
            >
              Start Free
              <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a
              href="#how-it-works"
              class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white px-5 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:bg-muted"
            >
              <svg class="h-4 w-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
              See how it works
            </a>
          </div>

          <!-- Trust badges -->
          <div class="mt-6 flex flex-wrap items-center gap-5 text-xs text-muted-foreground">
            <span class="flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              No MFA to users
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              No credit card
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5 text-success" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              2-minute setup
            </span>
          </div>
        </div>

        <!-- Right: Dashboard mockup -->
        <div class="relative">
          <!-- Glow -->
          <div class="absolute -inset-6 rounded-3xl bg-primary/8 blur-2xl" aria-hidden="true"></div>
          <div class="relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-elevated">

            <!-- Dashboard top bar -->
            <div class="flex items-center justify-between border-b border-gray-100 bg-gray-50/80 px-4 py-3">
              <div class="flex items-center gap-2.5">
                <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary">
                  <svg class="h-4 w-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <span class="text-sm font-semibold text-gray-800">QuickZTNA</span>
              </div>
              <span class="flex items-center gap-1.5 rounded-full bg-success/10 px-2.5 py-1 text-xs font-medium text-success">
                <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                All systems operational
              </span>
            </div>

            <!-- Sidebar + content -->
            <div class="flex">
              <!-- Sidebar -->
              <div class="w-32 shrink-0 border-r border-gray-100 bg-gray-50/60 py-3">
                {[
                  { icon: "▦", label: "Overview", active: true },
                  { icon: "⬡", label: "Devices", active: false },
                  { icon: "⊞", label: "Access", active: false },
                  { icon: "♟", label: "Users", active: false },
                  { icon: "≡", label: "Policies", active: false },
                  { icon: "◈", label: "Analytics", active: false },
                  { icon: "⚙", label: "Settings", active: false },
                ].map((item) => (
                  <div class={`flex items-center gap-2 px-3 py-1.5 text-xs ${item.active ? "bg-primary/10 text-primary font-medium rounded-md mx-1" : "text-gray-500 hover:text-gray-700"}`}>
                    <span class="text-[10px]">{item.icon}</span>
                    <span>{item.label}</span>
                  </div>
                ))}
              </div>

              <!-- Main content -->
              <div class="flex-1 p-4">
                <!-- Header row -->
                <div class="mb-3 flex items-center justify-between">
                  <p class="text-xs font-semibold text-gray-700">Main Overview</p>
                  <span class="flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success">
                    <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
                    All systems operational
                  </span>
                </div>

                <!-- Stats row -->
                <div class="mb-4 grid grid-cols-3 gap-2">
                  <div class="rounded-lg border border-gray-100 bg-gray-50 p-2.5 text-center">
                    <p class="text-base font-bold text-gray-900">100 / 100</p>
                    <p class="text-[10px] text-gray-500">Devices Online</p>
                  </div>
                  <div class="rounded-lg border border-gray-100 bg-gray-50 p-2.5 text-center">
                    <p class="text-base font-bold text-gray-900">12</p>
                    <p class="text-[10px] text-gray-500">Policies Active</p>
                  </div>
                  <div class="rounded-lg border border-gray-100 bg-gray-50 p-2.5 text-center">
                    <p class="text-base font-bold text-primary">3.2ms</p>
                    <p class="text-[10px] text-gray-500">Avg Latency</p>
                  </div>
                </div>

                <!-- Connected services -->
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400">Connected Services</p>
                    {[
                      { label: "Webservers", latency: "52ms", ok: true },
                      { label: "API Gateway", latency: "71ms", ok: true },
                      { label: "Database", latency: "30ms", ok: true },
                      { label: "Internal Server", latency: "9.5ms", ok: true },
                    ].map((svc) => (
                      <div class="mb-1 flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <span class={`h-1.5 w-1.5 rounded-full ${svc.ok ? "bg-success" : "bg-warning"}`}></span>
                          <span class="text-[10px] text-gray-600">{svc.label}</span>
                        </div>
                        <span class="text-[10px] font-mono text-gray-400">{svc.latency}</span>
                      </div>
                    ))}
                    <button class="mt-1.5 text-[10px] font-medium text-primary hover:underline">VIEW ACTIVITY →</button>
                  </div>
                  <div>
                    <p class="mb-1.5 text-[10px] font-semibold uppercase tracking-wider text-gray-400">Network Map</p>
                    <div class="flex h-20 items-center justify-center rounded-lg border border-dashed border-gray-200 bg-gray-50">
                      <div class="text-center">
                        <div class="relative mx-auto h-10 w-10">
                          <!-- Network nodes -->
                          <div class="absolute left-1/2 top-0 h-3 w-3 -translate-x-1/2 rounded-full bg-primary/30 border border-primary/60"></div>
                          <div class="absolute left-0 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full bg-gray-200 border border-gray-300"></div>
                          <div class="absolute right-0 top-1/2 h-3 w-3 -translate-y-1/2 rounded-full bg-gray-200 border border-gray-300"></div>
                          <div class="absolute bottom-0 left-1/2 h-3 w-3 -translate-x-1/2 rounded-full bg-gray-200 border border-gray-300"></div>
                          <!-- Center node -->
                          <div class="absolute left-1/2 top-1/2 h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary border-2 border-white shadow-sm"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FEATURE STRIP
  ═══════════════════════════════════════════════ -->
  <section class="bg-white pb-16 pt-4">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="overflow-hidden rounded-2xl border border-gray-200/80 bg-white p-4 shadow-soft sm:rounded-3xl sm:p-6 sm:shadow-elevated">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:gap-0 lg:divide-x lg:divide-gray-200/80">
          <!-- WireGuard -->
          <div class="flex items-center gap-3.5 px-3 py-2 sm:px-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center">
              <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 6v12" />
                <path d="M12 8a4 4 0 0 0 0 8" />
                <path d="M12 8a4 4 0 0 1 0 8" />
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900 leading-tight">WireGuard®</p>
              <p class="text-xs text-gray-500 leading-tight mt-0.5 whitespace-nowrap">High-performance mesh</p>
            </div>
          </div>

          <!-- Zero Trust -->
          <div class="flex items-center gap-3.5 px-3 py-2 sm:px-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center">
              <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900 leading-tight">Zero Trust</p>
              <p class="text-xs text-gray-500 leading-tight mt-0.5 whitespace-nowrap">Verify every request</p>
            </div>
          </div>

          <!-- ABAC -->
          <div class="flex items-center gap-3.5 px-3 py-2 sm:px-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center">
              <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l8 4.5v11L12 22l-8-4.5v-11L12 2z"/>
                <circle cx="12" cy="12" r="2.5"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900 leading-tight">ABAC</p>
              <p class="text-xs text-gray-500 leading-tight mt-0.5 whitespace-nowrap">Identity & context aware</p>
            </div>
          </div>

          <!-- AI Operator -->
          <div class="flex items-center gap-3.5 px-3 py-2 sm:px-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center">
              <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4l1.4-1.4M17 7l1.4-1.4"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900 leading-tight">AI Operator</p>
              <p class="text-xs text-gray-500 leading-tight mt-0.5 whitespace-nowrap">Policies & path lifecycle</p>
            </div>
          </div>

          <!-- Built for Scale -->
          <div class="flex items-center gap-3.5 px-3 py-2 sm:px-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center">
              <svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="2.5"/>
                <circle cx="6" cy="12" r="2.5"/>
                <circle cx="18" cy="19" r="2.5"/>
                <circle cx="6" cy="19" r="2.5"/>
                <path d="M18 7.5v9M8.5 12h7M8.5 19h7M6 14.5v2"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-900 leading-tight">Built for Scale</p>
              <p class="text-xs text-gray-500 leading-tight mt-0.5 whitespace-nowrap">From 10 to 1000+ devices</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       HOW IT WORKS
  ═══════════════════════════════════════════════ -->
  <section id="how-it-works" class="bg-white py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-3 text-center">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-primary">HOW IT WORKS</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          One platform. Three simple steps.
        </h2>
      </div>

      <div class="mt-14 grid items-center gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
        {[
          {
            n: "01",
            title: "Connect",
            desc: "Install the agent and join the secure mesh.",
            icon: `<svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
          },
          {
            n: "02",
            title: "Verify",
            desc: "We verify identity, device and posture.",
            icon: `<svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
          },
          {
            n: "03",
            title: "Control",
            desc: "Access is granted with least privilege, always.",
            icon: `<svg class="h-8 w-8 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
          },
        ].map((step, i) => (
          <>
            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-gray-50/80 p-8 text-center shadow-soft hover:shadow-elevated hover:border-primary/20 transition-all">
              <span class="mb-3 font-mono text-xs font-bold text-primary">{step.n}</span>
