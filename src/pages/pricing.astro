---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Button from "@/components/ui/Button.astro";
import { ArrowRight, Check, Zap } from "lucide-astro";

const AUTH_URL = "https://login.quickztna.com/auth";
const SALES_URL = "mailto:sales@quickztna.com?subject=QuickZTNA%20inquiry";

// 2 plans, IDENTICAL features. The only difference is scale (users + machines).
const plans = [
  {
    name: "Free",
    tagline: "For homelabs, founders, and small teams — forever.",
    price: "$0",
    per: "/mo forever",
    cta: "Start free",
    ctaHref: AUTH_URL,
    highlight: false,
    blurb: "Every feature included. No credit card. No trial clock.",
    limits: ["Up to 5 users", "5 machines per user (25 total)", "Community support"],
  },
  {
    name: "Business",
    tagline: "Same product — room to grow.",
    price: "$10",
    per: "per user / mo",
    cta: "Start free, upgrade anytime",
    ctaHref: AUTH_URL,
    highlight: true,
    blurb: "Identical features to Free. You pay to scale, not to unlock.",
    limits: ["Unlimited users (billed per seat)", "10 machines per user", "Priority email support"],
  },
];

// Everything below is included on BOTH plans (full feature parity). Listed once.
// Only shipped capabilities are advertised here.
const included = [
  {
    title: "Connectivity",
    items: ["WireGuard-encrypted ZTNA mesh", "MagicDNS", "Subnet routes + exit nodes", "Global DERP relays (Bangalore + Frankfurt)"],
  },
  {
    title: "Zero-trust access",
    items: ["ABAC / ACL policies", "Device posture + auto-quarantine", "JIT access workflow", "Policy versioning + rollback"],
  },
  {
    title: "Identity",
    items: ["SAML / OIDC SSO", "GitHub / Google OAuth", "TOTP MFA + backup codes", "SCIM 2.0 provisioning", "Org groups"],
  },
  {
    title: "AI assistant",
    items: ["AI chat", "Natural-language ACL builder", "Security digest", "Event summarizer", "Policy-drift detection", "Access heatmap"],
  },
  {
    title: "Security & data",
    items: ["DNS filtering", "Cloud firewall", "Data Loss Prevention (file scan)", "CASB + shadow-IT discovery", "User-risk scoring", "Secrets vault (AES-256-GCM)"],
  },
  {
    title: "Remote support & ops",
    items: ["Remote shell", "Remote desktop", "Session recording", "Compliance reports (SOC 2, ISO, HIPAA)", "Audit logs (90-day)"],
  },
];

// The actual difference between the plans — scale, not features.
const differs = [
  { label: "Price", free: "$0 forever", business: "$10 / user / mo" },
  { label: "Users", free: "Up to 5", business: "Unlimited (per seat)" },
  { label: "Machines", free: "5 / user (25 total)", business: "10 / user" },
  { label: "Features", free: "Everything", business: "Everything" },
  { label: "Support", free: "Community", business: "Priority email" },
];

const faqs = [
  {
    q: "What's the difference between Free and Business?",
    a: "Features are identical — both plans include everything. The difference is scale: Free is capped at 5 users and 5 machines per user (25 total); Business is $10 per user / month with unlimited seats and 10 machines per user. You pay to grow, not to unlock features.",
  },
  {
    q: "Is encryption or security different on Free?",
    a: "No. Every tunnel on both plans uses the same WireGuard cipher suite (X25519 + ChaCha20-Poly1305 + Poly1305), and every security feature — DLP, CASB, posture, SSO, audit logs — is available on Free too. Security is never the upsell.",
  },
  {
    q: "Is there a trial?",
    a: "No trial needed. The Free plan is full-featured forever for up to 5 users — try everything, then upgrade to Business only when you outgrow the seat or machine limits.",
  },
  {
    q: "What happens when I hit the Free limit?",
    a: "Device registration blocks at your cap (seats × 5 machines). Adding a paid Business seat raises the cap immediately. Nothing already registered is removed, and lowering seats is a manual admin action — we never auto-quarantine your machines.",
  },
  {
    q: "Why only Razorpay? What about Stripe / wire / invoice?",
    a: "We launched in India first, so Razorpay is the self-serve default (supports 100+ countries via Razorpay International). For other regions or invoice/wire payment, contact sales@quickztna.com. Stripe is on the roadmap.",
  },
  {
    q: "Is there a self-hosted / on-prem option?",
    a: "Not today — QuickZTNA is a managed cloud service (no self-host today). Contact sales@quickztna.com if air-gapped deployment is a requirement and we'll discuss your needs and our roadmap.",
  },
];

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "QuickZTNA",
  description:
    "Remote Workforce Security OS pricing. WireGuard ZTNA mesh + ABAC + AI Operator. Free forever for up to 5 users — every feature included.",
  brand: { "@type": "Brand", name: "QuickZTNA" },
  category: "Zero Trust Network Access",
  url: "https://quickztna.com/pricing/",
  image: "https://quickztna.com/favicon.svg",
  offers: [
    {
      "@type": "Offer",
      name: "Free",
      description: "Up to 5 users, 5 machines per user, every feature included, community support. Free forever, no credit card.",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: "https://login.quickztna.com/auth",
      eligibleCustomerType: "https://schema.org/Enduser",
    },
    {
      "@type": "Offer",
      name: "Business",
      description: "Unlimited users billed per seat, 10 machines per user, every feature included, priority email support.",
      price: "10",
      priceCurrency: "USD",
      priceSpecification: {
        "@type": "UnitPriceSpecification",
        price: "10",
        priceCurrency: "USD",
        unitText: "user/month",
        billingIncrement: 1,
      },
      availability: "https://schema.org/InStock",
      url: "https://login.quickztna.com/auth",
    },
  ],
  aggregateRating: undefined,
};

const pricingFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const pricingBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://quickztna.com" },
    { "@type": "ListItem", position: 2, name: "Pricing", item: "https://quickztna.com/pricing/" },
  ],
};
---
<SiteLayout
  title="Pricing — QuickZTNA: free forever for 5 users, Business at $10 per user"
  description="Two plans, identical features. Free forever for up to 5 users (5 machines each). Business at $10 per user / month to scale. Every feature on every plan — you pay for scale, not unlocks."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(pricingFaqSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(pricingBreadcrumbSchema)} is:inline />
  </Fragment>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-hero border-b border-border">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8 lg:py-24">
      <p class="font-mono text-xs uppercase tracking-wider text-primary">Pricing</p>
      <h1 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
        Every feature, <span class="text-gradient">free to start</span>.
        <br class="hidden sm:block" /> Pay only to scale.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Two plans, identical features. Free forever for up to 5 users — every capability included.
        Upgrade to Business at $10/user only when you need more seats and machines. No trial clock.
      </p>
    </div>
  </section>

  <!-- PLAN CARDS -->
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid gap-5 sm:grid-cols-2">
      {plans.map((p) => (
        <div class={`group relative flex flex-col overflow-hidden rounded-2xl border p-8 shadow-soft transition-all ${
          p.highlight
            ? "border-primary bg-gradient-to-br from-primary/[0.04] via-surface-elevated to-surface-elevated ring-1 ring-primary/20"
            : "border-border bg-surface-elevated"
        }`}>
          {p.highlight && (
            <span class="mb-4 inline-flex w-fit items-center gap-1.5 rounded-full bg-primary px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-primary-foreground">
              <Zap class="h-3 w-3" />For scaling teams
            </span>
          )}
          <h3 class="text-2xl font-semibold tracking-tight">{p.name}</h3>
          <p class="mt-1 text-sm text-muted-foreground">{p.tagline}</p>

          <div class="mt-6 flex items-baseline gap-1.5">
            <span class="text-5xl font-semibold tracking-tight">{p.price}</span>
            <span class="text-sm text-muted-foreground">{p.per}</span>
          </div>

          <p class="mt-4 text-sm font-medium text-foreground">{p.blurb}</p>

          <ul class="mt-5 space-y-1.5 font-mono text-xs text-muted-foreground">
            {p.limits.map((l) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-primary/60"></span>
                {l}
              </li>
            ))}
          </ul>

          <div class="my-7 border-t border-border"></div>

          <p class="flex items-start gap-2.5 text-sm text-muted-foreground">
            <Check class="mt-0.5 h-4 w-4 shrink-0 text-primary" strokeWidth={2.5} />
            <span>Every feature below — DLP, CASB, SSO/SCIM, remote desktop, session recording, the AI assistant, the lot.</span>
          </p>

          <Button
            size="lg"
            href={p.ctaHref}
            variant={p.highlight ? "default" : "outline"}
            class="mt-8 h-11 font-medium"
          >
            {p.cta}
            <ArrowRight class="ml-1.5 h-4 w-4" />
          </Button>
          <p class="mt-3 text-center text-[11px] text-muted-foreground">No credit card required</p>
        </div>
      ))}
    </div>

    <!-- What actually differs -->
    <div class="mx-auto mt-12 max-w-2xl overflow-hidden rounded-2xl border border-border bg-surface-elevated shadow-soft">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border text-left">
            <th class="px-5 py-3.5 font-semibold text-foreground">The only differences</th>
            <th class="w-32 px-3 py-3.5 text-center font-semibold text-foreground">Free</th>
            <th class="w-32 px-3 py-3.5 text-center font-semibold text-primary">Business</th>
          </tr>
        </thead>
        <tbody>
          {differs.map((d) => (
            <tr class="border-t border-border/60">
              <td class="px-5 py-3 text-foreground">{d.label}</td>
              <td class="px-3 py-3 text-center text-muted-foreground">{d.free}</td>
              <td class="px-3 py-3 text-center font-medium text-foreground">{d.business}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- EVERYTHING INCLUDED (parity) -->
  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-mono text-xs uppercase tracking-wider text-primary">Included on every plan</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          The whole platform — on Free too.
        </h2>
        <p class="mt-3 text-muted-foreground">
          No feature gates. Free and Business get exactly the same capabilities. If it's here, it ships.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {included.map((g) => (
          <div class="rounded-2xl border border-border bg-surface-elevated p-6 shadow-soft">
            <h3 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{g.title}</h3>
            <ul class="mt-4 space-y-2.5 text-sm">
              {g.items.map((it) => (
                <li class="flex items-start gap-2.5 text-muted-foreground">
                  <Check class="mt-0.5 h-4 w-4 shrink-0 text-success" strokeWidth={2.5} />
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="font-mono text-xs uppercase tracking-wider text-primary">FAQ</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Questions, answered honestly.</h2>
    </div>
    <div class="mt-10 grid gap-3">
      {faqs.map((f) => (
        <details class="group rounded-xl border border-border bg-surface-elevated shadow-soft transition-all open:shadow-elevated">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-foreground list-none [&::-webkit-details-marker]:hidden">
            <span>{f.q}</span>
            <svg class="h-4 w-4 shrink-0 transition-transform group-open:rotate-45 text-muted-foreground" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="10" y1="4" x2="10" y2="16"></line>
              <line x1="4" y1="10" x2="16" y2="10"></line>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground">
            {f.a}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- BOTTOM CTA -->
  <section class="relative overflow-hidden border-t border-border bg-surface">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-border bg-gradient-to-br from-primary to-chart-2 p-12 text-primary-foreground shadow-elevated lg:p-16">
        <div class="absolute inset-0 bg-grid opacity-10"></div>
        <div class="relative grid items-center gap-8 lg:grid-cols-[1.5fr_1fr]">
          <div>
            <Zap class="h-8 w-8" />
            <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
              Get your whole team on zero-trust today.
            </h2>
            <p class="mt-3 max-w-xl text-primary-foreground/85">
              Free for up to 5 users, every feature included. Issue one auth key, run one install command,
              and your team is on the mesh.
            </p>
          </div>
          <div class="flex flex-col gap-3">
            <Button size="lg" variant="secondary" href={AUTH_URL} class="h-11 font-medium">
              Start free — no card
              <ArrowRight class="ml-1.5 h-4 w-4" />
            </Button>
            <a
              href={SALES_URL}
              class="inline-flex h-11 items-center justify-center rounded-md border border-primary-foreground/30 px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-foreground/10"
            >
              Talk to sales
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
