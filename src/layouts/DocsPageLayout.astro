---
import SiteLayout from "./SiteLayout.astro";
import Sidebar from "@/components/docs/Sidebar.astro";
import TableOfContents from "@/components/blog/TableOfContents.astro";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

interface Props {
  // We accept either a docs or guide entry — schema overlaps enough that one
  // layout serves both. Per-collection chrome (breadcrumb label, etc.) is
  // switched on the `collection` field.
  entry: CollectionEntry<"docs"> | CollectionEntry<"guide">;
  collection: "docs" | "guide";
}

const { entry, collection } = Astro.props;
const { data } = entry;
const { headings } = await render(entry);

const siteUrl = "https://quickztna.com";
const slug = entry.id.replace(/\.md$/, "");
const isIndex = slug === "index" || slug === "";
const path = isIndex ? `/${collection}/` : `/${collection}/${slug}/`;
const canonical = `${siteUrl}${path}`;
const ogImage = `${siteUrl}/og/${collection}-${isIndex ? "index" : slug}.svg`;

const collectionLabel = collection === "docs" ? "Docs" : "User guide";
const collectionRoot = `/${collection}/`;

// ── Schema.org ──────────────────────────────────────────────────────────
const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: data.title,
  description: data.description,
  datePublished: data.updatedAt.toISOString(),
  dateModified: data.updatedAt.toISOString(),
  author: {
    "@type": "Organization",
    name: "QuickZTNA",
    url: siteUrl,
  },
  publisher: {
    "@type": "Organization",
    name: "QuickZTNA",
    logo: { "@type": "ImageObject", url: `${siteUrl}/logo.png` },
  },
  mainEntityOfPage: canonical,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
    { "@type": "ListItem", position: 2, name: collectionLabel, item: `${siteUrl}${collectionRoot}` },
    ...(isIndex
      ? []
      : [{ "@type": "ListItem", position: 3, name: data.title, item: canonical }]),
  ],
};

const faqSchema =
  data.faq && data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: data.faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

const howToSchema =
  "howToSteps" in data && data.howToSteps && data.howToSteps.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: data.title,
        step: data.howToSteps.map((s, i) => ({
          "@type": "HowToStep",
          position: i + 1,
          name: s.name,
          text: s.text,
        })),
      }
    : null;
---
<SiteLayout
  title={`${data.title} | QuickZTNA ${collectionLabel}`}
  description={data.description}
  canonical={canonical}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
    {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} is:inline />}
  </Fragment>

  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-primary focus:px-3 focus:py-1 focus:text-sm focus:text-primary-foreground"
  >
    Skip to content
  </a>

  <div class="border-b border-border/50 bg-muted/20">
    <nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 py-2 sm:px-6 lg:px-8">
      <ol class="flex flex-wrap items-center gap-1 font-mono text-xs text-muted-foreground">
        <li><a href="/" class="hover:text-primary">Home</a></li>
        <li aria-hidden="true" class="text-border">/</li>
        <li>
          <a href={collectionRoot} class="hover:text-primary">{collectionLabel}</a>
        </li>
        {!isIndex && (
          <>
            <li aria-hidden="true" class="text-border">/</li>
            <li class="text-foreground truncate max-w-xs">{data.title}</li>
          </>
        )}
      </ol>
    </nav>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-[16rem_1fr] lg:gap-10 xl:grid-cols-[16rem_1fr_15rem] xl:gap-12">
      <!-- Left sidebar — sticky nav -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <Sidebar collection={collection} currentPath={path} />
        </div>
      </aside>

      <!-- Article -->
      <article id="main-content" class="min-w-0">
        <header class="mb-8">
          <p class="mb-2 font-mono text-[11px] font-semibold uppercase tracking-wider text-primary">
            {collectionLabel}
          </p>
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-foreground sm:text-4xl">
            {data.title}
          </h1>
          <p class="mt-3 text-lg leading-relaxed text-muted-foreground">{data.description}</p>
          <p class="mt-4 font-mono text-xs text-muted-foreground">
            Last updated {data.updatedAt.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </p>
        </header>

        {data.tocEnabled !== false && (
          <TableOfContents headings={headings} />
        )}

        <div
          class="prose prose-slate max-w-none
            prose-headings:scroll-mt-28 prose-headings:font-bold
            prose-h2:mt-12 prose-h2:text-2xl prose-h2:border-b prose-h2:border-border/50 prose-h2:pb-2
            prose-h3:mt-8 prose-h3:text-xl
            prose-p:leading-relaxed prose-p:text-foreground/80
            prose-a:text-primary prose-a:underline-offset-2 prose-a:font-medium
            prose-code:rounded prose-code:bg-muted prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
            prose-pre:rounded-xl prose-pre:border prose-pre:border-border prose-pre:bg-muted
            prose-blockquote:border-l-primary prose-blockquote:bg-accent/30 prose-blockquote:rounded-r-lg prose-blockquote:py-0.5
            prose-table:text-sm prose-th:bg-muted prose-th:font-semibold
            prose-img:rounded-xl prose-img:border prose-img:border-border
            prose-strong:text-foreground"
        >
          <slot />
        </div>

        {data.faq && data.faq.length > 0 && (
          <section class="mt-16 border-t border-border pt-10" id="faq">
            <h2 class="text-2xl font-bold text-foreground">Frequently asked questions</h2>
            <dl class="mt-6 space-y-6">
              {data.faq.map((item) => (
                <div class="rounded-xl border border-border bg-card p-5">
                  <dt class="text-base font-semibold text-foreground">{item.q}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <aside class="mt-12 rounded-2xl border border-primary/20 bg-gradient-to-br from-accent/50 to-background p-6">
          <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-primary">Start free</p>
          <h3 class="mt-2 text-xl font-semibold text-foreground">
            100 devices and 3 users, free forever
          </h3>
          <p class="mt-2 text-sm text-muted-foreground">
            WireGuard-encrypted mesh, ABAC policies, and device posture. No credit card.
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="https://login.quickztna.com/auth" class="rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity">
              Create account
            </a>
            <a href="/pricing/" class="rounded-md border border-border bg-background px-5 py-2.5 text-sm font-medium hover:bg-muted transition-colors">
              Pricing
            </a>
          </div>
        </aside>
      </article>

      <!-- Right rail — desktop ToC -->
      <aside class="hidden xl:block">
        <div class="sticky top-24 space-y-6">
          {data.tocEnabled !== false && <TableOfContents headings={headings} />}
        </div>
      </aside>
    </div>
  </div>
</SiteLayout>
