---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ShareButtons from "@/components/blog/ShareButtons.astro";
import AuthorCard from "@/components/blog/AuthorCard.astro";
import RelatedPosts from "@/components/blog/RelatedPosts.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data, id } = post;
const slug = id.replace(/\.md$/, "");

const canonical = `https://www.quickztna.com/blog/${slug}/`;
const published = data.publishedAt.toISOString();
const modified = (data.updatedAt ?? data.publishedAt).toISOString();
const readingTime = data.wordCount ? Math.ceil(data.wordCount / 230) : null;

const categoryLabel: Record<string, string> = {
  architecture: "Architecture",
  comparison: "Comparison",
  compliance: "Compliance",
  technical: "Technical",
  fundamentals: "Fundamentals",
  industry: "Industry",
};

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${canonical}#article`,
  url: canonical,
  headline: data.title,
  description: data.description,
  datePublished: published,
  dateModified: modified,
  inLanguage: "en-US",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
  author: {
    "@type": "Person",
    name: data.author.name,
    jobTitle: data.author.role,
    url: data.author.url ?? "https://www.quickztna.com",
  },
  publisher: {
    "@type": "Organization",
    name: "QuickZTNA",
    url: "https://www.quickztna.com",
    logo: {
      "@type": "ImageObject",
      url: "https://www.quickztna.com/favicon.svg",
    },
  },
  keywords: [data.primaryKeyword, ...data.tags].join(", "),
  articleSection: categoryLabel[data.category] ?? data.category,
  wordCount: data.wordCount,
  dependencies: "WireGuard, Go, Linux kernel >= 5.6",
  proficiencyLevel: "Professional",
};

const faqSchema =
  data.faq && data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: data.faq.map((item) => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.a,
          },
        })),
      }
    : null;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.quickztna.com",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: "https://www.quickztna.com/blog/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: data.title,
      item: canonical,
    },
  ],
};
---

<SiteLayout
  title={`${data.title} — QuickZTNA Blog`}
  description={data.description}
  canonical={canonical}
  ogImage={data.heroImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
    )}
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="border-b border-border bg-surface py-3">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
          <li><a href="/" class="hover:text-primary font-medium transition-colors">Home</a></li>
          <li aria-hidden="true" class="text-border">/</li>
          <li><a href="/blog/" class="hover:text-primary font-medium transition-colors">Blog</a></li>
          <li aria-hidden="true" class="text-border">/</li>
          <li class="truncate max-w-[240px] sm:max-w-md text-primary font-bold" aria-current="page">
            {data.title}
          </li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">

      <!-- ── ARTICLE BODY ─────────────────────────────────────────── -->
      <article id="main-content" class="min-w-0">

        <!-- Article header -->
        <header class="mb-8 pb-8 border-b border-gray-100">
          <!-- Category + reading time -->
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <a
              href={`/blog/?category=${data.category}`}
              class="rounded-full border border-accent/25 bg-accent-light px-3.5 py-1 font-mono text-[11px] font-bold uppercase tracking-wider text-accent hover:bg-accent hover:text-white transition-all"
            >
              {categoryLabel[data.category] ?? data.category}
            </a>
            {readingTime && (
              <span class="font-mono text-xs text-muted-foreground font-medium">· {readingTime} min read</span>
            )}
            {data.wordCount && (
              <span class="font-mono text-xs text-muted-foreground font-medium">· {data.wordCount.toLocaleString()} words</span>
            )}
          </div>

          <!-- Title -->
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-primary sm:text-4xl lg:text-5xl">
            {data.title}
          </h1>

          <!-- Description -->
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-muted-foreground font-medium">{data.description}</p>

          <!-- Author + dates -->
          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs sm:text-sm text-muted-foreground">
            <address class="not-italic">
              By <span class="font-bold text-primary">{data.author.name}</span>
              {data.author.role && <span class="ml-1 text-xs text-muted-foreground">({data.author.role})</span>}
            </address>
            <span aria-hidden="true">·</span>
            <time datetime={published} class="font-mono text-xs">
              {data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </time>
            {data.updatedAt && (
              <>
                <span aria-hidden="true">·</span>
                <span class="font-mono text-xs">
                  Updated {data.updatedAt.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                </span>
              </>
            )}
          </div>

          <!-- Hero image -->
          {data.heroImage && (
            <div class="mt-8 overflow-hidden rounded-2xl border border-border shadow-soft">
              <img
                src={data.heroImage}
                alt={data.heroAlt ?? data.title}
                width={1200}
                height={630}
                loading="eager"
                decoding="async"
                class="w-full object-cover"
              />
            </div>
          )}
        </header>

        <!-- Prose content -->
        <div
          id="article-body"
          class="prose prose-slate max-w-none
            prose-headings:scroll-mt-28 prose-headings:font-bold prose-headings:text-primary
            prose-h2:mt-12 prose-h2:text-2xl prose-h2:border-b prose-h2:border-border prose-h2:pb-2
            prose-h3:mt-8 prose-h3:text-xl
            prose-p:leading-relaxed prose-p:text-gray-700
            prose-a:text-accent prose-a:underline-offset-2 prose-a:font-semibold hover:prose-a:underline
            prose-code:rounded prose-code:bg-surface prose-code:border prose-code:border-border prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-code:font-mono prose-code:text-accent prose-code:before:content-none prose-code:after:content-none
            prose-pre:rounded-2xl prose-pre:border prose-pre:border-border prose-pre:bg-primary prose-pre:text-white
            prose-blockquote:border-l-accent prose-blockquote:bg-accent-light prose-blockquote:rounded-r-xl prose-blockquote:py-1 prose-blockquote:px-4 prose-blockquote:text-primary
            prose-table:text-sm prose-th:bg-surface prose-th:font-bold prose-th:text-primary
            prose-img:rounded-2xl prose-img:border prose-img:border-border prose-img:shadow-soft
            prose-strong:text-primary prose-strong:font-bold"
        >
          <slot />
        </div>

        <!-- FAQ section -->
        {data.faq.length > 0 && (
          <section class="mt-16 border-t border-border pt-10" id="faq">
            <h2 class="text-2xl font-bold text-primary mb-6">Frequently asked questions</h2>
            <div class="space-y-4">
              {data.faq.map((item) => (
                <div class="rounded-2xl border border-border bg-surface p-5 shadow-soft">
                  <h3 class="text-base font-bold text-primary">{item.q}</h3>
                  <p class="mt-2 text-xs sm:text-sm leading-relaxed text-muted-foreground font-medium">{item.a}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Author card -->
        <div class="mt-12 border-t border-border pt-8">
          <AuthorCard
            name={data.author.name}
            role={data.author.role}
            url={data.author.url}
          />
        </div>

        <!-- Share + tags row -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-gray-100">
          <div class="flex flex-wrap gap-1.5">
            {data.tags.map((tag) => (
              <span class="rounded-full border border-border bg-surface px-3 py-1 font-mono text-[11px] text-muted-foreground hover:border-accent hover:text-accent transition-colors cursor-default">
                #{tag}
              </span>
            ))}
          </div>
          <ShareButtons title={data.title} url={canonical} />
        </div>

        <!-- Bottom CTA banner -->
        <aside class="mt-12 rounded-2xl border border-border bg-primary p-6 sm:p-8 text-white shadow-elevated" aria-label="Try QuickZTNA">
          <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-accent block mb-1">
            Instant mesh deploy
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-white">
            Zero Trust mesh — free for up to 5 users, forever
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-gray-300 font-medium leading-relaxed max-w-xl">
            WireGuard-encrypted mesh, ABAC policies, workforce DLP, and device posture. No credit card, no trial expiry on the free plan.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="https://login.quickztna.com/auth" class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-2.5 text-xs font-bold text-white hover:bg-accent/95 shadow-md shadow-accent/20 transition-all active:scale-95">
              Start free — no card required
            </a>
            <a href="/pricing/" class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white/10 px-5 py-2.5 text-xs font-semibold text-white hover:bg-white/20 transition-all">
              Compare plans
            </a>
          </div>
        </aside>
      </article>

      <!-- ── RIGHT SIDEBAR ────────────────────────────────────────── -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">

          <!-- Sidebar CTA -->
          <div class="rounded-2xl border border-border bg-surface p-5 shadow-soft">
            <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-accent block mb-1">FREE FOREVER</span>
            <h4 class="text-sm font-bold text-primary leading-snug">
              Zero Trust mesh for your whole team
            </h4>
            <p class="mt-1.5 text-xs text-muted-foreground font-medium leading-relaxed">
              WireGuard mesh + DLP + AI Operator. One command install. No credit card.
            </p>
            <a
              href="https://login.quickztna.com/auth"
              class="mt-4 block w-full rounded-full bg-accent py-2.5 text-center text-xs font-bold text-white hover:bg-accent/95 shadow-md shadow-accent/20 transition-all active:scale-95"
            >
              Start free →
            </a>
          </div>

          <!-- Related posts -->
          {data.relatedSlugs && data.relatedSlugs.length > 0 && (
            <RelatedPosts slugs={data.relatedSlugs} currentSlug={slug} />
          )}

        </div>
      </aside>

    </div>
  </div>
</SiteLayout>
