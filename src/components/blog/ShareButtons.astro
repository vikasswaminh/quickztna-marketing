---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encoded = encodeURIComponent(url);
const text = encodeURIComponent(title);
---
<div class="not-prose flex items-center gap-2">
  <span class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Share</span>
  <a
    href={`https://twitter.com/intent/tweet?text=${text}&url=${encoded}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on X (Twitter)"
    class="rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-muted transition-colors"
  >
    X / Twitter
  </a>
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encoded}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on LinkedIn"
    class="rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-muted transition-colors"
  >
    LinkedIn
  </a>
  <button
    id="copy-link-btn"
    data-url={url}
    aria-label="Copy link"
    class="rounded-md border border-border px-3 py-1.5 text-xs font-medium hover:bg-muted transition-colors"
  >
    Copy link
  </button>
</div>

<script>
  const btn = document.getElementById("copy-link-btn") as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener("click", async () => {
      const u = btn.dataset.url ?? window.location.href;
      await navigator.clipboard.writeText(u).catch(() => {});
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => { btn.textContent = orig; }, 1500);
    });
  }
</script>
