---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filtered.length > 1 && (
  <>
    <!-- Mobile: collapsible -->
    <details class="lg:hidden mb-8 rounded-xl border border-border bg-muted/30 p-4">
      <summary class="cursor-pointer font-mono text-xs font-semibold uppercase tracking-wider text-muted-foreground select-none">
        Table of contents
      </summary>
      <nav aria-label="Table of contents (mobile)" class="mt-3">
        <ol class="space-y-1.5 pl-1">
          {filtered.map((h) => (
            <li class={h.depth === 3 ? "pl-4" : ""}>
              <a
                href={`#${h.slug}`}
                class="block rounded py-0.5 text-sm text-muted-foreground hover:text-primary transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>

    <!-- Desktop: sticky sidebar -->
    <nav
      id="toc"
      aria-label="Table of contents"
      class="hidden lg:block sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto rounded-xl border border-border bg-card p-5 shadow-sm"
    >
      <p class="mb-4 font-mono text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
        On this page
      </p>
      <ol class="space-y-1.5" id="toc-list">
        {filtered.map((h) => (
          <li class={h.depth === 3 ? "pl-3" : ""}>
            <a
              href={`#${h.slug}`}
              data-toc-link
              class={`toc-link block rounded-md px-2 py-1 text-sm transition-colors text-muted-foreground hover:text-foreground hover:bg-muted ${h.depth === 3 ? "text-xs" : ""}`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </>
)}

<script>
  // Highlight active ToC item via IntersectionObserver, no framework
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((a) => {
      const id = a.getAttribute("href")?.slice(1);
      if (id) map.set(id, a);
    });

    const setActive = (id: string) => {
      links.forEach((a) => {
        a.classList.remove("text-primary", "font-semibold", "bg-muted/50");
        a.classList.add("text-muted-foreground");
      });
      const active = map.get(id);
      if (active) {
        active.classList.add("text-primary", "font-semibold", "bg-muted/50");
        active.classList.remove("text-muted-foreground");
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
    );

    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
