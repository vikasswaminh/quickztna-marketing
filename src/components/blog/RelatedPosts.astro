---
import { getCollection } from "astro:content";

interface Props {
  slugs: string[];
  currentSlug: string;
}

const { slugs, currentSlug } = Astro.props;
const all = await getCollection("blog", ({ data }) => !data.draft);

const related = slugs
  .map((s) => all.find((p) => p.id.replace(/\.md$/, "") === s))
  .filter(Boolean)
  .slice(0, 3) as (typeof all)[number][];
---

{related.length > 0 && (
  <div class="rounded-2xl border border-border bg-white p-5 shadow-soft">
    <p class="mb-3 font-mono text-[11px] font-bold uppercase tracking-widest text-primary">
      Related posts
    </p>
    <ul class="space-y-3 divide-y divide-gray-100">
      {related.map((post, idx) => {
        const slug = post.id.replace(/\.md$/, "");
        return (
          <li class={idx > 0 ? "pt-3" : ""}>
            <a
              href={`/blog/${slug}/`}
              class="group block transition-all"
            >
              <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-accent">
                {post.data.category.replace("-", " ")}
              </span>
              <p class="mt-1 text-xs font-bold leading-snug text-primary group-hover:text-accent transition-colors line-clamp-2">
                {post.data.title}
              </p>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
)}
