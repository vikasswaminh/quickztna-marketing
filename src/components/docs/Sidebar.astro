---
// Shared sidebar for /docs/* and /guide/*. Nav tree lives in src/lib/nav.ts
// (single source of truth shared with the top-nav dropdowns in Header.astro),
// so adding a page updates the sidebar and the header dropdowns together.
import { docsNav, guideNav } from "@/lib/nav";

interface Props {
  collection: "docs" | "guide";
  currentPath: string;
}
const { collection, currentPath } = Astro.props;

const groups = collection === "docs" ? docsNav : guideNav;
const otherLabel = collection === "docs" ? "User guide" : "Developer docs";
const otherHref = collection === "docs" ? "/guide/" : "/docs/";

const norm = (s: string) => s.replace(/\/$/, "") || "/";
const cur = norm(currentPath);
---
<nav aria-label={`${collection} navigation`} class="text-sm">
  <!-- Cross-link to the other collection so people don't get stranded -->
  <a
    href={otherHref}
    class="mb-6 flex items-center justify-between rounded-md border border-border bg-muted/40 px-3 py-2 text-xs font-medium text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary"
  >
    <span>Looking for the {otherLabel.toLowerCase()}?</span>
    <span aria-hidden="true">→</span>
  </a>

  {groups.map((g) => (
    <div class="mb-5">
      <h4 class="mb-2 font-mono text-[11px] font-semibold uppercase tracking-wider text-foreground">
        {g.title}
      </h4>
      <ul class="space-y-1 border-l border-border/60 pl-3">
        {g.items.map((it) => {
          const active = norm(it.href) === cur;
          return (
            <li>
              <a
                href={it.href}
                aria-current={active ? "page" : undefined}
                class={`block rounded px-2 py-1 transition-colors ${
                  active
                    ? "bg-primary/10 text-primary font-semibold"
                    : "text-muted-foreground hover:text-foreground hover:bg-muted/60"
                }`}
              >
                {it.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
