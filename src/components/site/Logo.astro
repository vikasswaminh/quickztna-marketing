---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---
<div class={`flex items-center gap-2 ${className}`}>
  <div class="relative h-7 w-7">
    <div class="absolute inset-0 rounded-md bg-gradient-to-br from-accent to-primary"></div>
    <div class="absolute inset-[3px] rounded-[5px] bg-white"></div>
    <div class="absolute inset-[6px] rounded-[3px] bg-gradient-to-br from-accent to-primary"></div>
  </div>
  <span class="font-mono text-base font-bold tracking-tight text-primary">
    Quick<span class="text-accent">ZTNA</span>
  </span>
</div>
