---
import Logo from "./Logo.astro";
import Button from "@/components/ui/Button.astro";
import { docsNav, guideNav } from "@/lib/nav";

const AUTH_URL = "https://login.quickztna.com/auth";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));

const triggerBase =
  "inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition-colors hover:text-foreground";

// Product dropdown items
const productItems = [
  { label: "Overview", href: "/", desc: "Remote Workforce Security OS" },
  { label: "Features", href: "/features", desc: "Full platform feature set" },
  { label: "Workforce", href: "/workforce", desc: "For distributed teams" },
  { label: "Pricing", href: "/pricing", desc: "Free forever · $10/user to scale" },
  { label: "Savings", href: "/savings", desc: "Compare vs alternatives" },
];

// Resources dropdown items
const resourceItems = [
  { label: "User Guide", href: "/guide/" },
  { label: "Quickstart", href: "/guide/quickstart/" },
  { label: "Documentation", href: "/docs/" },
  { label: "API Reference", href: "/docs/api/" },
  { label: "Blog", href: "/blog/" },
];
---

<header class="sticky top-0 z-40 w-full border-b border-border/60 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center">
      <Logo />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-0.5 md:flex">

      <!-- Product dropdown -->
      <div class="group relative">
        <button
          type="button"
          aria-haspopup="menu"
          class={`${triggerBase} ${isActive("/") && path === "/" ? "text-foreground" : "text-muted-foreground"}`}
        >
          Product
          <svg data-chev class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="w-64 rounded-xl border border-border bg-white p-2 shadow-elevated">
            {productItems.map((item) => (
              <a href={item.href} class="flex flex-col rounded-lg px-3 py-2.5 transition-colors hover:bg-muted">
                <span class="text-sm font-medium text-foreground">{item.label}</span>
                <span class="text-xs text-muted-foreground">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Features link -->
      <a
        href="/features"
        class={`${triggerBase} ${isActive("/features") ? "text-foreground" : "text-muted-foreground"}`}
      >
        Features
      </a>

      <!-- Pricing link -->
      <a
        href="/pricing"
        class={`${triggerBase} ${isActive("/pricing") ? "text-foreground" : "text-muted-foreground"}`}
      >
        Pricing
      </a>

      <!-- Documentation dropdown -->
      <div class="group relative">
        <button
          type="button"
          aria-haspopup="menu"
          class={`${triggerBase} ${isActive("/docs") ? "text-foreground" : "text-muted-foreground"}`}
        >
          Documentation
          <svg data-chev class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="w-56 rounded-xl border border-border bg-white p-2 shadow-elevated">
            {docsNav.map((g) => (
              <a href={g.items[0].href} class="block rounded-lg px-3 py-2.5 transition-colors hover:bg-muted">
                <span class="block text-sm font-medium text-foreground">{g.title}</span>
                <span class="block text-xs text-muted-foreground">{g.items[0].label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Resources dropdown -->
      <div class="group relative">
        <button
          type="button"
          aria-haspopup="menu"
          class={`${triggerBase} ${isActive("/guide") || isActive("/blog") ? "text-foreground" : "text-muted-foreground"}`}
        >
          Resources
          <svg data-chev class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute right-0 top-full z-50 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="w-48 rounded-xl border border-border bg-white p-2 shadow-elevated">
            {resourceItems.map((item) => (
              <a href={item.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={AUTH_URL}
        class="hidden rounded-md px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground sm:inline-flex"
      >
        Login
      </a>
      <a
        href={AUTH_URL}
        class="inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-all hover:bg-primary/90 hover:shadow-glow"
      >
        Start Free
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-nav" class="hidden border-t border-border/60 bg-white md:hidden">
    <nav class="mx-auto max-w-7xl space-y-1 px-4 py-3 text-sm sm:px-6">
      {productItems.map((l) => (
        <a href={l.href} class="block rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-foreground">{l.label}</a>
      ))}

      <!-- Docs (collapsible) -->
      <button type="button" data-section="m-docs" class="flex w-full items-center justify-between rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
        <span>Documentation</span>
        <svg data-chevron class="h-3.5 w-3.5 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div id="m-docs" class="hidden space-y-0.5 border-l border-border/60 pl-3">
        {docsNav.map((g) => (
          <a href={g.items[0].href} class="block rounded px-3 py-1.5 text-muted-foreground hover:bg-muted hover:text-foreground">{g.title}</a>
        ))}
      </div>

      <!-- Resources (collapsible) -->
      <button type="button" data-section="m-resources" class="flex w-full items-center justify-between rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
        <span>Resources</span>
        <svg data-chevron class="h-3.5 w-3.5 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div id="m-resources" class="hidden space-y-0.5 border-l border-border/60 pl-3">
        {resourceItems.map((it) => (
          <a href={it.href} class="block rounded px-3 py-1.5 text-muted-foreground hover:bg-muted hover:text-foreground">{it.label}</a>
        ))}
      </div>

      <div class="pt-2 border-t border-border/60 flex gap-2">
        <a href={AUTH_URL} class="flex-1 rounded-md px-3 py-2 text-center text-sm font-medium text-muted-foreground hover:bg-muted">Login</a>
        <a href={AUTH_URL} class="flex-1 rounded-full bg-primary px-3 py-2 text-center text-sm font-semibold text-primary-foreground">Start Free →</a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.getElementById("mobile-nav-toggle");
    const menu = document.getElementById("mobile-nav");
    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const nowOpen = menu.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(nowOpen));
      });
    }
    document.querySelectorAll<HTMLButtonElement>("[data-section]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-section");
        if (!id) return;
        document.getElementById(id)?.classList.toggle("hidden");
        btn.querySelector("[data-chevron]")?.classList.toggle("rotate-180");
      });
    });
  }
  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
