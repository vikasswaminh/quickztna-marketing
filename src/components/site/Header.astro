---
import Logo from "./Logo.astro";

const AUTH_URL = "https://login.quickztna.com/auth";

const docsNav = [
  {
    title: "Concepts",
    items: [
      { label: "Overview", href: "/docs/concepts/#overview" },
      { label: "Zero Trust Network Access (ZTNA)", href: "/docs/concepts/#ztna" },
      { label: "Attribute-Based Access Control (ABAC)", href: "/docs/concepts/#abac" },
      { label: "WireGuard Mesh & DERP", href: "/docs/concepts/#wireguard-mesh-derp" },
    ],
  },
  {
    title: "Security & Posture",
    items: [
      { label: "Device Posture Checks", href: "/docs/security/#device-posture" },
      { label: "Data Loss Prevention (DLP)", href: "/docs/security/#dlp" },
      { label: "CASB & App Controls", href: "/docs/security/#casb" },
      { label: "Encryption & Key Management", href: "/docs/security/#encryption" },
    ],
  },
  {
    title: "Integrations",
    items: [
      { label: "SSO & Identity Providers", href: "/docs/integrations/#sso" },
      { label: "SCIM 2.0 Provisioning", href: "/docs/integrations/#scim" },
      { label: "SIEM & Audit Streaming", href: "/docs/integrations/#siem" },
    ],
  },
  {
    title: "API & Developer",
    items: [
      { label: "REST API Reference", href: "/docs/api/" },
      { label: "CLI Reference", href: "/docs/cli/" },
      { label: "Terraform Provider", href: "/docs/integrations/#terraform" },
    ],
  },
];

const guideNav = [
  {
    title: "Getting Started",
    items: [
      { label: "Quickstart (2 min)", href: "/guide/quickstart/" },
      { label: "Installation", href: "/guide/installation/" },
      { label: "Connecting Your First Device", href: "/guide/connecting/" },
      { label: "Managing Devices", href: "/guide/managing-devices/" },
    ],
  },
  {
    title: "Networking",
    items: [
      { label: "Access Policies", href: "/guide/access-policies/" },
      { label: "Exit Nodes & Subnet Routes", href: "/guide/exit-nodes-and-routes/" },
      { label: "Troubleshooting", href: "/guide/troubleshooting/" },
    ],
  },
  {
    title: "Workforce & Admin",
    items: [
      { label: "Workforce Security Overview", href: "/guide/admin/workforce/" },
      { label: "AI Operator", href: "/guide/admin/ai-operator/" },
      { label: "Device Posture Policies", href: "/guide/admin/device-posture/" },
      { label: "DLP & Content Scanning", href: "/guide/admin/dlp/" },
      { label: "CASB & Shadow IT", href: "/guide/admin/casb/" },
    ],
  },
  {
    title: "Platform Administration",
    items: [
      { label: "Identity & SSO Setup", href: "/guide/admin/identity/" },
      { label: "DNS Filtering & MagicDNS", href: "/guide/admin/dns-filtering/" },
      { label: "Remote Access & Shell", href: "/guide/admin/remote-access/" },
      { label: "Workforce Analytics", href: "/guide/admin/workforce-analytics/" },
      { label: "Audit Logs & Observability", href: "/guide/admin/observability/" },
      { label: "Billing & Subscriptions", href: "/guide/admin/billing/" },
    ],
  },
];

const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  path === "/" ? pathname === "/" : pathname.startsWith(path);

const linkCls = (path: string) =>
  `px-3 py-1.5 text-sm font-medium transition-colors rounded-md ${
    isActive(path)
      ? "text-primary font-semibold bg-muted"
      : "text-muted-foreground hover:text-primary hover:bg-muted/60"
  }`;

const triggerBase =
  "inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium rounded-md transition-colors hover:text-primary hover:bg-muted/60";
---

<header class="sticky top-0 z-40 w-full border-b border-border/80 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Left: Logo -->
    <a href="/" class="flex items-center gap-2 group cursor-pointer no-underline" aria-label="QuickZTNA Home">
      <Logo />
    </a>

    <!-- Center navigation -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary Navigation">
      <a href="/" class={linkCls("/")}>Home</a>
      <a href="/features" class={linkCls("/features")}>Features</a>
      <a href="/pricing" class={linkCls("/pricing")}>Pricing</a>
      <a href="/savings" class={linkCls("/savings")}>Savings</a>

      <!-- Docs dropdown -->
      <div class="group relative">
        <button
          type="button"
          aria-haspopup="menu"
          class={`${triggerBase} ${isActive("/docs") ? "text-primary bg-muted font-semibold" : "text-muted-foreground"}`}
        >
          Docs
          <svg data-chev class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="w-64 rounded-xl border border-border bg-white p-2 shadow-elevated">
            {docsNav.map((g) => (
              <a href={g.items[0].href} class="block rounded-lg px-3 py-2.5 transition-colors hover:bg-muted">
                <span class="block text-sm font-medium text-primary">{g.title}</span>
                <span class="block text-xs text-muted-foreground">{g.items[0].label}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Guide dropdown -->
      <div class="group relative">
        <button
          type="button"
          aria-haspopup="menu"
          class={`${triggerBase} ${isActive("/guide") ? "text-primary bg-muted font-semibold" : "text-muted-foreground"}`}
        >
          Guide
          <svg data-chev class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="grid w-[34rem] max-w-[calc(100vw-2rem)] grid-cols-2 gap-x-6 gap-y-4 rounded-xl border border-border bg-white p-4 shadow-elevated">
            {guideNav.map((g) => (
              <div>
                <p class="mb-1.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-accent">{g.title}</p>
                <ul class="space-y-0.5">
                  {g.items.map((it) => (
                    <li>
                      <a href={it.href} class="block rounded px-2 py-1 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-primary">{it.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Blog -->
      <a href="/blog" class={linkCls("/blog")}>Blog</a>
    </nav>

    <!-- Right side buttons -->
    <div class="flex items-center gap-3">
      <a
        href={AUTH_URL}
        class="hidden rounded-md px-3 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-primary sm:inline-flex"
      >
        Login
      </a>
      <a
        href={AUTH_URL}
        class="inline-flex items-center gap-1.5 rounded-full bg-accent hover:bg-accent/95 px-4 py-2 text-xs font-bold text-white transition-all shadow-sm shadow-accent/20 active:scale-95"
      >
        Start Free
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-primary md:hidden"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-nav" class="hidden border-t border-border/60 bg-white md:hidden">
    <nav class="mx-auto max-w-7xl space-y-1 px-4 py-3 text-sm sm:px-6">
      <a href="/" class="block rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-primary">Home</a>
      <a href="/features" class="block rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-primary">Features</a>
      <a href="/pricing" class="block rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-primary">Pricing</a>
      <a href="/savings" class="block rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-primary">Savings</a>

      <!-- Docs (collapsible) -->
      <button type="button" data-section="m-docs" class="flex w-full items-center justify-between rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-primary">
        <span>Docs</span>
        <svg data-chevron class="h-3.5 w-3.5 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div id="m-docs" class="hidden space-y-0.5 border-l border-border/60 pl-3">
        {docsNav.map((g) => (
          <a href={g.items[0].href} class="block rounded px-3 py-1.5 text-muted-foreground hover:bg-muted hover:text-primary">{g.title}</a>
        ))}
      </div>

      <!-- Guide (collapsible) -->
      <button type="button" data-section="m-guide" class="flex w-full items-center justify-between rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-primary">
        <span>Guide</span>
        <svg data-chevron class="h-3.5 w-3.5 transition-transform" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div id="m-guide" class="hidden border-l border-border/60 pl-3">
        {guideNav.map((g) => (
          <div class="mb-2">
            <p class="px-3 py-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-accent">{g.title}</p>
            {g.items.map((it) => (
              <a href={it.href} class="block rounded px-3 py-1.5 text-muted-foreground hover:bg-muted hover:text-primary">{it.label}</a>
            ))}
          </div>
        ))}
      </div>

      <a href="/blog" class="block rounded-md px-3 py-2 font-medium text-muted-foreground hover:bg-muted hover:text-primary">Blog</a>

      <div class="flex gap-2 border-t border-border/60 pt-2">
        <a href={AUTH_URL} class="flex-1 rounded-md px-3 py-2 text-center text-sm font-medium text-muted-foreground hover:bg-muted">Login</a>
        <a href={AUTH_URL} class="flex-1 rounded-full bg-accent hover:bg-accent/95 px-3 py-2 text-center text-sm font-bold text-white shadow-sm">Start Free →</a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.getElementById("mobile-nav-toggle");
    const menu = document.getElementById("mobile-nav");
    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const nowOpen = menu.classList.toggle("hidden") === false;
        toggle.setAttribute("aria-expanded", String(nowOpen));
      });
    }
    document.querySelectorAll<HTMLButtonElement>("[data-section]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-section");
        if (!id) return;
        document.getElementById(id)?.classList.toggle("hidden");
        btn.querySelector("[data-chevron]")?.classList.toggle("rotate-180");
      });
    });
  }
  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
