---
import Logo from "./Logo.astro";

type Item = { label: string; href: string; external?: boolean };

const product: Item[] = [
  { label: "Features", href: "/features" },
  { label: "Pricing", href: "/pricing" },
  { label: "Download", href: "https://login.quickztna.com/download", external: true },
  { label: "API", href: "/docs/api/" },
];
const resources: Item[] = [
  { label: "Quickstart", href: "/guide/quickstart/" },
  { label: "Tutorials", href: "/guide/" },
  { label: "Blog", href: "/blog/" },
];
const company: Item[] = [
  { label: "About", href: "/" },
  { label: "Contact", href: "mailto:sales@quickztna.com" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Terms of Service", href: "/terms" },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-100 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-4">
      <!-- Brand column -->
      <div class="md:col-span-1">
        <Logo />
        <p class="mt-3 text-xs font-semibold text-muted-foreground">QuickZTNA</p>
        <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
          The Remote Workforce Security OS.<br />
          Zero Trust. Zero Complexity.
        </p>
        <!-- Social icons -->
        <div class="mt-5 flex items-center gap-3">
          <a
            href="https://twitter.com/quickztna"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter / X"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 text-gray-400 transition-colors hover:border-gray-300 hover:text-gray-600"
          >
            <!-- X / Twitter -->
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.742l7.731-8.847L1.254 2.25H8.08l4.259 5.63 5.905-5.63Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com/company/quickztna"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 text-gray-400 transition-colors hover:border-gray-300 hover:text-gray-600"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://in.linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn India"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 text-gray-400 transition-colors hover:border-gray-300 hover:text-gray-600"
          >
            <span class="text-[10px] font-bold">in</span>
          </a>
          <a
            href="https://github.com/quickztna"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="flex h-8 w-8 items-center justify-center rounded-lg border border-gray-200 text-gray-400 transition-colors hover:border-gray-300 hover:text-gray-600"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
        <!-- Status -->
        <p class="mt-5 flex items-center gap-1.5 text-xs text-muted-foreground">
          <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
          All systems operational
        </p>
      </div>

      <!-- Nav columns -->
      {[
        { title: "PRODUCT", items: product },
        { title: "RESOURCES", items: resources },
        { title: "COMPANY", items: company },
      ].map((col) => (
        <div>
          <h4 class="mb-4 font-mono text-[10px] font-bold uppercase tracking-widest text-gray-400">{col.title}</h4>
          <ul class="space-y-2.5">
            {col.items.map((it) => (
              <li>
                <a
                  href={it.href}
                  target={it.external ? "_blank" : undefined}
                  rel={it.external ? "noopener noreferrer" : undefined}
                  class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                >
                  {it.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-gray-100 pt-6 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <p>© {year} QuickZTNA, All rights reserved.</p>
    </div>
  </div>
</footer>
