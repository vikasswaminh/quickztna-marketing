---
import Logo from "./Logo.astro";

type Item = { label: string; href: string; external?: boolean };

const product: Item[] = [
  { label: "Features", href: "/features" },
  { label: "Pricing", href: "/pricing" },
  { label: "Dashboard", href: "https://login.quickztna.com", external: true },
  { label: "Download", href: "https://login.quickztna.com/download", external: true },
];
const resources: Item[] = [
  { label: "User guide", href: "/guide/" },
  { label: "Quickstart", href: "/guide/quickstart/" },
  { label: "Developer docs", href: "/docs/" },
  { label: "API reference", href: "/docs/api/" },
  { label: "Security model", href: "/docs/security/" },
  { label: "Blog", href: "/blog/" },
];
const company: Item[] = [
  { label: "Sign in", href: "https://login.quickztna.com/auth", external: true },
  { label: "Sign up", href: "https://login.quickztna.com/auth", external: true },
  { label: "Contact sales", href: "mailto:sales@quickztna.com" },
  { label: "security@quickztna.com", href: "mailto:security@quickztna.com" },
];
// Sibling brands under the Olla Group — dofollow cross-links for backlinking.
const brands: Item[] = [
  { label: "OllaBear", href: "https://ollabear.com" },
  { label: "OllaDNS", href: "https://olladns.com" },
  { label: "OllaGraph", href: "https://ollagraph.com" },
  { label: "OllaLink", href: "https://ollalink.com" },
  { label: "OllaNode", href: "https://ollanode.com" },
  { label: "OllaSoftware", href: "https://ollasoftware.com" },
  { label: "OllaStack", href: "https://ollastack.com" },
  { label: "OllaSuper", href: "https://ollasuper.com" },
  { label: "OllaSync", href: "https://ollasync.com" },
  { label: "OllaVPN", href: "https://ollavpn.com" },
  { label: "OllaWrite", href: "https://ollawrite.com" },
];
const year = new Date().getFullYear();
---
<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-5">
      <div class="md:col-span-2">
        <Logo />
        <p class="mt-4 max-w-sm text-sm text-muted-foreground">
          Zero Trust network access for distributed teams. WireGuard mesh + ABAC policy + device posture. Your whole team in 2 minutes. Free for up to 5 users.
        </p>
        <p class="mt-4 font-mono text-xs text-muted-foreground">
          <span class="text-success">●</span> All systems operational
        </p>
      </div>
      {[
        { title: "Product", items: product },
        { title: "Resources", items: resources },
        { title: "Company", items: company },
      ].map((col) => (
        <div>
          <h4 class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-foreground">{col.title}</h4>
          <ul class="space-y-2 text-sm text-muted-foreground">
            {col.items.map((it) => (
              <li>
                <a
                  href={it.href}
                  target={it.external ? "_blank" : undefined}
                  rel={it.external ? "noopener noreferrer" : undefined}
                  class="hover:text-foreground"
                >
                  {it.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 border-t border-border pt-6">
      <h4 class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-foreground">Part of the Olla Group</h4>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted-foreground">
        {brands.map((it) => (
          <li>
            <a
              href={it.href}
              target="_blank"
              rel="noopener"
              class="hover:text-foreground"
            >
              {it.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="mt-8 flex flex-col items-start justify-between gap-4 border-t border-border pt-6 text-xs text-muted-foreground md:flex-row md:items-center">
      <p>© {year} QuickZTNA — Remote Workforce Security OS.</p>
      <div class="flex gap-4">
        <a href="/privacy" class="hover:text-foreground">Privacy</a>
        <a href="/terms" class="hover:text-foreground">Terms</a>
        <a href="/refund-policy" class="hover:text-foreground">Refund</a>
        <a href="/docs/security/" class="hover:text-foreground">Security</a>
      </div>
    </div>
  </div>
</footer>
